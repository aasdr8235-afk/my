---
// Root entrypoint: Canonical Arabic edition lives at /ar/, English at /en/
// Static and edge redirect to /ar/
import { SITE_CONFIG } from '../config/site';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تحويل إلى النسخة العربية | Mouhib Writeups</title>
    <meta http-equiv="refresh" content="0;url=/ar/" />
    <link rel="canonical" href={`${SITE_CONFIG.url}/ar/`} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline>
      window.location.replace('/ar/');
    </script>
    <style>
      body {
        margin: 0;
        background-color: #FAF8F2;
        color: #151515;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans Arabic", sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        text-align: center;
        padding: 2rem;
      }
      .redirect-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }
      .logo {
        width: 48px;
        height: 48px;
      }
      a {
        color: #5F6849;
        text-decoration: underline;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <div class="redirect-box">
      <img src="/assets/brand/logo-transparent.png" alt="Mouhib Writeups" class="logo" width="48" height="48" />
      <p>جارٍ التحويل إلى <a href="/ar/">النسخة العربية</a>... / Redirecting to <a href="/en/">English Edition</a></p>
    </div>
  </body>
</html>
