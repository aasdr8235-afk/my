import LeakageVectorsDiagram from '../../../components/diagrams/LeakageVectorsDiagram.astro';
import TwoFactorTimelineDiagram from '../../../components/diagrams/TwoFactorTimelineDiagram.astro';
import CookieFlagsDiagram from '../../../components/diagrams/CookieFlagsDiagram.astro';
