const tocItems = [
  { id: 'sec-01', num: '01', title: 'تسجيل الدخول والتحقق' },
  { id: 'sec-02', num: '02', title: 'بنية حالة الجلسة' },
  { id: 'sec-03', num: '03', title: 'بروتوكول الطلب والكوكي' },
  { id: 'sec-04', num: '04', title: 'معضلة الثقة في السيرفر' },
  { id: 'sec-05', num: '05', title: 'متجهات تسرب الجلسات' },
  { id: 'sec-06', num: '06', title: 'حدود المصادقة الثنائية (2FA)' },
  { id: 'sec-07', num: '07', title: 'خصائص حماية الكوكي' },
  { id: 'sec-08', num: '08', title: 'دورة حياة الجلسة الكاملة' },
  { id: 'sec-09', num: '09', title: 'إرشادات الدفاع للمستخدم' },
  { id: 'sec-10', num: '10', title: 'الخلاصة' }
];

const pageTitle = "كيف تُسرق جلسة تسجيل الدخول بدون سرقة كلمة السر؟";
const pageSubtitle = "أحيانًا المهاجم لا يحتاج كلمة السر أصلًا. يكفيه الشيء الذي يثبت أنك سجّلت الدخول بالفعل.";
const pageDescription = "كيف تُسرق جلسة تسجيل الدخول دون معرفة كلمة السر؟ شرح تفصيلي لـSession Cookies، معايير HttpOnly وSameSite، وهجمات XSS وMan-in-the-Middle وكيفية حماية الجلسات.";
const socialTitle = "كيف تستمر جلسة الموقع حتى بعد إغلاق المتصفح؟ وكيف تُخطف؟";
const ogImage = "/assets/og/session-hijacking.jpg";
---

<ArticleLayout
