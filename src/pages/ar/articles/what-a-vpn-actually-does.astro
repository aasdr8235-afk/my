const pageTitle = "ماذا يفعل VPN فعلًا؟ ومن يستطيع رؤية اتصالك؟";
const pageSubtitle = "الـVPN لا يحذف الثقة. هو فقط ينقلها.";
const pageDescription = "ماذا يفعل VPN فعليًا لحركة بياناتك؟ توضيح تقني لما يراه مزود الإنترنت (ISP)، الفرق بين تشفير VPN وتشفير HTTPS، وفهم حدود الخصوصية دون مبالغات تسويقية.";
