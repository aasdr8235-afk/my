const tocItems = [
  { id: 'sec-01', num: '01', title: 'الاتصال الطبيعي بدون نفق' },
  { id: 'sec-02', num: '02', title: 'حدود نفق الـVPN المشفر' },
  { id: 'sec-03', num: '03', title: 'ما يراه مزود الإنترنت (ISP)' },
  { id: 'sec-04', num: '04', title: 'ما يستطيع مزود الـVPN رؤيته' },
  { id: 'sec-05', num: '05', title: 'ما يراه الموقع الهدف والهوية' },
  { id: 'sec-06', num: '06', title: 'استعلامات DNS ومعضلة التسرب' },
