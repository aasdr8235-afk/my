---
interface Props {
  title?: string;
}

const { title = "Technical Note" } = Astro.props;
---

<aside class="technical-note">
  <div class="technical-note-title">
    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="8" cy="8" r="6"/>
      <line x1="8" y1="7" x2="8" y2="11"/>
      <circle cx="8" cy="5" r="0.75" fill="currentColor"/>
    </svg>
    <span>{title}</span>
  </div>
  <div class="technical-note-body">
    <slot />
  </div>
</aside>
