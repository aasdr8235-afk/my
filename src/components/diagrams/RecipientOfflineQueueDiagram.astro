---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'دورة حياة طابور التخزين وإعادة التمرير عند انقطاع اتصال المستلم' : 'Store-and-forward queue lifecycle when recipient is offline'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 05 / طوابير الانتظار' : 'FIGURE 05 / STORE-AND-FORWARD QUEUE'}
    </span>
    <span>
      {lang === 'ar' ? 'إدارة الرسائل المعلقة أثناء انقطاع اتصال المستلم وتفريغها عند عودته' : 'Queueing, retention policy, and drain-upon-reconnection'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="q-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="q-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="q-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Phase 1: Ingestion & Offline Detection -->
      <g transform="translate(25, 35)">
        <rect width="175" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="175" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">PHASE 1: ARRIVAL</text>

        <rect x="10" y="38" width="155" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">MESSAGE INGESTED</text>
        <text x="16" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Accepted by edge gateway</text>
        <text x="16" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Sender receives Server Ack</text>

        <rect x="10" y="96" width="155" height="50" fill="#FAF8F2" stroke="#D32F2F" stroke-width="0.8"/>
        <text x="16" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#D32F2F">SOCKET CHECK</text>
        <text x="16" y="124" font-family="sans-serif" font-size="7.5" fill="#D32F2F">• No active TCP/TLS session</text>
        <text x="16" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Recipient phone offline</text>

        <rect x="10" y="154" width="155" height="42" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="16" y="170" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">STATE: UNROUTABLE</text>
        <text x="16" y="184" font-family="sans-serif" font-size="7" fill="#5F5D56">Routed to queue storage</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="200" y1="140" x2="230" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#q-arrow)"/>

      <!-- Phase 2: Pending Mailbox Queue -->
      <g transform="translate(235, 35)">
        <rect width="215" height="210" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="215" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">PHASE 2: STORE-AND-FORWARD</text>

        <!-- Queue Stack visual -->
        <g transform="translate(10, 36)">
          <rect width="195" height="28" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
          <text x="10" y="18" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#5F6849">Msg 03 (Newest - Pending)</text>

          <rect y="32" width="195" height="28" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
          <text x="10" y="50" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">Msg 02 (Pending delivery)</text>

          <rect y="64" width="195" height="28" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
          <text x="10" y="82" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">Msg 01 (Pending delivery)</text>
        </g>

        <!-- Policy Box -->
        <rect x="10" y="138" width="195" height="60" fill="url(#q-hatch)" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="154" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">RETENTION POLICIES</text>
        <text x="16" y="168" font-family="sans-serif" font-size="7.5" fill="#151515">• Service-configured retention window</text>
        <text x="16" y="180" font-family="sans-serif" font-size="7" fill="#5F5D56">• Messages preserved until recipient reconnects</text>
        <text x="16" y="192" font-family="sans-serif" font-size="7" fill="#5F5D56">• Dropped/expired only if window lapses</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="450" y1="140" x2="480" y2="140" stroke="#5F6849" stroke-width="1.8" marker-end="url(#q-arrow-olive)"/>

      <!-- Phase 3: Reconnection & Drain -->
      <g transform="translate(485, 35)">
        <rect width="170" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="170" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">PHASE 3: RECONNECTION</text>

        <rect x="10" y="38" width="150" height="50" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">CLIENT CONNECTS</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Establishes TLS socket</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Hands over auth token</text>

        <rect x="10" y="96" width="150" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">QUEUE DRAIN</text>
        <text x="14" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Fetches pending in order</text>
        <text x="14" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Streams batches to client</text>

        <rect x="10" y="154" width="150" height="42" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="170" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">INBOX SYNCHRONIZED</text>
        <text x="14" y="184" font-family="sans-serif" font-size="7" fill="#5F5D56">Client verifies sequence</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <line x1="655" y1="140" x2="680" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#q-arrow)"/>

      <!-- Phase 4: Delivery Ack & Purge -->
      <g transform="translate(685, 35)">
        <rect width="110" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="110" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="17" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">PHASE 4: ACK</text>

        <rect x="8" y="38" width="94" height="74" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="10" y="52" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#5F6849">CLIENT ACK</text>
        <text x="10" y="66" font-family="sans-serif" font-size="7" fill="#5F5D56">• Confirms receipt</text>
        <text x="10" y="80" font-family="sans-serif" font-size="7" fill="#5F5D56">• Sends ACK frame</text>
        <text x="10" y="96" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#5F6849">ACK RETURNED</text>

        <rect x="8" y="122" width="94" height="78" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="10" y="136" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#151515">QUEUE PURGE</text>
        <text x="10" y="150" font-family="sans-serif" font-size="7" fill="#5F5D56">• Message cleared</text>
        <text x="10" y="164" font-family="sans-serif" font-size="7" fill="#5F5D56">• Mailbox pruned</text>
        <text x="10" y="180" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#151515">STATUS: DELIVERED</text>
      </g>
    </svg>
  </div>
</figure>
