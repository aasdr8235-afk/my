---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'توجيه العملية عبر شبكات البطاقات العالمية ومقسمات BIN' : 'Global routing across card network switches to issuing bank'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 06 / شبكات البطاقات' : 'FIGURE 06 / CARD SCHEME SWITCHING'}
    </span>
    <span>
      {lang === 'ar' ? 'كيف توجه شبكات الدفع (Visa / Mastercard) العملية إلى بنكك المصدر؟' : 'BIN / IIN routing across global interbank clearing switches'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="net-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="net-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="net-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Node 1: Acquirer -->
      <g transform="translate(25, 40)">
        <rect width="180" height="200" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="180" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">ACQUIRING BANK</text>

        <rect x="10" y="38" width="160" height="48" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">MERCHANT'S BANK</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Collects terminal request</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Inspects card brand</text>

        <rect x="10" y="94" width="160" height="48" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="108" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">BRAND SWITCH IDENT</text>
        <text x="14" y="122" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• 4... -> Visa Switch</text>
        <text x="14" y="134" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• 5... -> Mastercard Switch</text>

        <rect x="10" y="150" width="160" height="38" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="166" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">Dedicated leased line</text>
        <text x="14" y="178" font-family="sans-serif" font-size="7" fill="#5F5D56">Direct switch connection</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="205" y1="140" x2="245" y2="140" stroke="#5F6849" stroke-width="1.8" marker-end="url(#net-arr-olive)"/>
      <text x="210" y="130" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">Auth Req</text>

      <!-- Node 2: Card Scheme Global Switch (Centerpiece) -->
      <g transform="translate(255, 30)">
        <rect width="300" height="220" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="300" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">CARD SCHEME NETWORK SWITCH (VISA / MC / INTERBANK)</text>

        <rect x="10" y="36" width="280" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.8"/>
        <text x="16" y="50" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">BIN / IIN ROUTING TABLE (FIRST 6-8 DIGITS)</text>
        <text x="16" y="64" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">BIN 411122 -> Target Host: ISSUER_BANK_891 (FR)</text>
        <text x="16" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Global distributed directory of all licensed card issuers</text>

        <rect x="10" y="96" width="280" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="16" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">NETWORK-LEVEL FRAUD & STAND-IN (STIP)</text>
        <text x="16" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Real-time cross-merchant risk heuristics</text>
        <text x="16" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Stand-In processing if issuer host times out</text>

        <rect x="10" y="156" width="280" height="48" fill="url(#net-hatch)" stroke="#5F6849" stroke-width="0.7"/>
        <text x="16" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">ULTRA-LOW LATENCY GLOBAL FIBER</text>
        <text x="16" y="186" font-family="sans-serif" font-size="7" fill="#5F5D56">Transit latency across continents: typically 30-100 ms</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="555" y1="140" x2="595" y2="140" stroke="#5F6849" stroke-width="1.8" marker-end="url(#net-arr-olive)"/>
      <text x="560" y="130" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">Routed</text>

      <!-- Node 3: Issuing Bank Host -->
      <g transform="translate(605, 40)">
        <rect width="185" height="200" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="185" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">ISSUING BANK</text>

        <rect x="10" y="38" width="165" height="48" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">CARDHOLDER'S BANK</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Holds user account balance</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Owns cryptographic root key</text>

        <rect x="10" y="94" width="165" height="48" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="108" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">AUTH ENGINE</text>
        <text x="14" y="122" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Verifies chip ARQC</text>
        <text x="14" y="134" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Evaluates credit & limits</text>

        <rect x="10" y="150" width="165" height="38" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="166" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">Final authority</text>
        <text x="14" y="178" font-family="sans-serif" font-size="7" fill="#5F5D56">Approves or Declines</text>
      </g>
    </svg>
  </div>
</figure>
