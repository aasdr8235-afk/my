---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'البنية التحتية للخوادم وبوابات التوجيه' : 'Provider edge architecture and internal routing flow'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 04 / البنية التحتية' : 'FIGURE 04 / PROVIDER EDGE & ROUTING'}
    </span>
    <span>
      {lang === 'ar' ? 'معالجة الرسالة داخل بوابات المزود وموجهات الجلسات' : 'Ingestion, auth verification, and session routing'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="srv-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="srv-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="srv-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Step 1: Ingress Edge Gateway -->
      <g transform="translate(25, 35)">
        <rect width="170" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="170" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">1. EDGE INGRESS</text>

        <rect x="10" y="38" width="150" height="48" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">TLS TERMINATION</text>
        <text x="16" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Accepts client frame</text>
        <text x="16" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Rate limit & DDOS check</text>

        <rect x="10" y="94" width="150" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="108" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">AUTH VERIFICATION</text>
        <text x="16" y="122" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Validates session token</text>
        <text x="16" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Matches sender identity</text>

        <rect x="10" y="154" width="150" height="44" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.7"/>
        <text x="16" y="169" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">SERVER ACK EMITTED</text>
        <text x="16" y="183" font-family="sans-serif" font-size="7" fill="#5F5D56">Returns status to sender</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="195" y1="140" x2="225" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#srv-arrow)"/>

      <!-- Step 2: Routing & Directory Lookup -->
      <g transform="translate(230, 35)">
        <rect width="175" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="175" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">2. ROUTER & DIRECTORY</text>

        <rect x="10" y="38" width="155" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">ACCOUNT RESOLUTION</text>
        <text x="16" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Looks up recipient UUID</text>
        <text x="16" y="80" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Enumerates active devices</text>

        <rect x="10" y="98" width="155" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.7"/>
        <text x="16" y="112" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">SESSION LOOKUP</text>
        <text x="16" y="126" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Queries in-memory registry</text>
        <text x="16" y="140" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Checks gateway host ID</text>

        <rect x="10" y="158" width="155" height="40" fill="url(#srv-hatch)" stroke="#151515" stroke-width="0.6"/>
        <text x="16" y="176" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">State: Online vs Offline</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="405" y1="140" x2="435" y2="140" stroke="#5F6849" stroke-width="1.6" marker-end="url(#srv-arrow-olive)"/>

      <!-- Step 3: Message Broker / Queue Subsystem -->
      <g transform="translate(440, 35)">
        <rect width="175" height="210" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.5"/>
        <rect width="175" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">3. BROKER / QUEUE</text>

        <rect x="10" y="38" width="155" height="48" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">INGESTION STREAM</text>
        <text x="16" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• High-throughput broker</text>
        <text x="16" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Distributed commit log</text>

        <rect x="10" y="94" width="155" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.7"/>
        <text x="16" y="108" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">PERSISTENCE</text>
        <text x="16" y="122" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Temporary inbox mailbox</text>
        <text x="16" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Retention policy applied</text>

        <rect x="10" y="154" width="155" height="44" fill="#EBE7DE" stroke="#151515" stroke-width="0.7"/>
        <text x="16" y="170" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">ORDER PRESERVATION</text>
        <text x="16" y="184" font-family="sans-serif" font-size="7" fill="#5F5D56">Conversation sequence IDs</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <line x1="615" y1="140" x2="645" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#srv-arrow)"/>

      <!-- Step 4: Dispatch Decision -->
      <g transform="translate(650, 35)">
        <rect width="145" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="145" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">4. DISPATCH</text>

        <rect x="8" y="38" width="129" height="74" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">CASE A: ONLINE</text>
        <text x="12" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Forward to host gateway</text>
        <text x="12" y="80" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Push down active socket</text>
        <text x="12" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">IMMEDIATE PUSH</text>

        <rect x="8" y="122" width="129" height="78" fill="#FAF8F2" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="136" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">CASE B: OFFLINE</text>
        <text x="12" y="150" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Store in pending queue</text>
        <text x="12" y="164" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Emit push notification</text>
        <text x="12" y="180" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">WAKE / DEFER</text>
      </g>
    </svg>
  </div>
</figure>
