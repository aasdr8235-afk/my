---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مسار استيقاظ التطبيق عبر شبكات الإشعارات الرسمية' : 'Push notification wakeup pathway via APNs and FCM'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 06 / مسار الإشعارات' : 'FIGURE 06 / PUSH NOTIFICATION WAKEUP'}
    </span>
    <span>
      {lang === 'ar' ? 'كيف توقظ خوادم آبل وجوجل الهاتف دون كشف نص المحادثة' : 'How APNs and FCM wake the device without exposing message plaintext'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="push-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="push-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="push-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Step 1: Messaging Backend -->
      <g transform="translate(25, 35)">
        <rect width="180" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="180" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">1. APP SERVICE BACKEND</text>

        <rect x="10" y="38" width="160" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">TRIGGER DECISION</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Recipient client is sleeping</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Retrieves push token</text>

        <rect x="10" y="96" width="160" height="50" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">PUSH PAYLOAD</text>
        <text x="14" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Generic wakeup token</text>
        <text x="14" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• No plaintext required</text>

        <rect x="10" y="154" width="160" height="42" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="170" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">DISPATCH TO GATEWAY</text>
        <text x="14" y="184" font-family="sans-serif" font-size="7" fill="#5F5D56">HTTP/2 POST to APNs/FCM</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="205" y1="140" x2="235" y2="140" stroke="#5F6849" stroke-width="1.8" marker-end="url(#push-arrow-olive)"/>

      <!-- Step 2: Push Platform (APNs / FCM) -->
      <g transform="translate(240, 35)">
        <rect width="210" height="210" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="210" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">2. PUSH NETWORK (APPLE/GOOGLE)</text>

        <rect x="10" y="38" width="190" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">DEVICE SOCKET REGISTRY</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Single persistent OS socket</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Low-power heartbeat link</text>

        <rect x="10" y="96" width="190" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">ROUTING TOKEN MATCH</text>
        <text x="14" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Maps push token to device IP</text>
        <text x="14" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Sends binary push frame</text>

        <rect x="10" y="154" width="190" height="42" fill="url(#push-hatch)" stroke="#5F6849" stroke-width="0.7"/>
        <text x="14" y="170" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">BATTERY OPTIMIZED</text>
        <text x="14" y="184" font-family="sans-serif" font-size="7" fill="#5F5D56">Prevents 50 apps holding 50 open sockets</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="450" y1="140" x2="480" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#push-arrow)"/>

      <!-- Step 3: Device OS Daemon -->
      <g transform="translate(485, 35)">
        <rect width="165" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="165" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">3. MOBILE OS DAEMON</text>

        <rect x="10" y="38" width="145" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">RECEIVE PUSH FRAME</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Handled by apsd or GooglePlay</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Verifies app signature</text>

        <rect x="10" y="96" width="145" height="50" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">PROCESS WAKE</text>
        <text x="14" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Launches app process</text>
        <text x="14" y="136" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Grants brief execution time</text>

        <rect x="10" y="154" width="145" height="42" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="170" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">WAKE SIGNAL</text>
        <text x="14" y="184" font-family="sans-serif" font-size="7" fill="#5F5D56">Silent push or user banner</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <line x1="650" y1="140" x2="680" y2="140" stroke="#5F6849" stroke-width="1.8" marker-end="url(#push-arrow-olive)"/>

      <!-- Step 4: Messaging App Process -->
      <g transform="translate(685, 35)">
        <rect width="110" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="110" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="17" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">4. APP PROCESS</text>

        <rect x="8" y="38" width="94" height="74" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="10" y="52" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#5F6849">CONNECT & FETCH</text>
        <text x="10" y="66" font-family="sans-serif" font-size="7" fill="#5F5D56">• Woken up</text>
        <text x="10" y="78" font-family="sans-serif" font-size="7" fill="#5F5D56">• Reconnects TLS</text>
        <text x="10" y="90" font-family="sans-serif" font-size="7" fill="#5F5D56">• Drains payload</text>
        <text x="10" y="104" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#5F6849">FETCH PAYLOAD</text>

        <rect x="8" y="122" width="94" height="78" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="10" y="136" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#151515">LOCAL DISPLAY</text>
        <text x="10" y="150" font-family="sans-serif" font-size="7" fill="#5F5D56">• Decrypts locally</text>
        <text x="10" y="164" font-family="sans-serif" font-size="7" fill="#5F5D56">• Renders alert</text>
        <text x="10" y="180" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#151515">UI UPDATED</text>
      </g>
    </svg>
  </div>
</figure>
