---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'المخطط الشامل لتسلسل عملية الدفع اللاتلامسي' : 'Comprehensive end-to-end contactless payment multi-party sequence'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 10 / الرحلة الشاملة' : 'FIGURE 10 / COMPLETE PAYMENT PIPELINE'}
    </span>
    <span>
      {lang === 'ar' ? 'من التلامس الكهرومغناطيسي إلى التفويض البنكي في ثانيتين' : 'From electromagnetic tap to issuer authorization in 2 seconds'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="sum-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="sum-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="sum-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Stage 1: Card Tap (NFC EMV) -->
      <g transform="translate(25, 30)">
        <rect width="145" height="175" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="145" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">1. CARD / PHONE</text>

        <rect x="8" y="32" width="129" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="12" y="46" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">13.56 MHz FIELD</text>
        <text x="12" y="58" font-family="sans-serif" font-size="7" fill="#5F5D56">• Inductive power harvest</text>
        <text x="12" y="68" font-family="sans-serif" font-size="7" fill="#5F5D56">• Chip boots in &lt;10 ms</text>

        <rect x="8" y="80" width="129" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="94" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">ARQC CRYPTOGRAM</text>
        <text x="12" y="106" font-family="sans-serif" font-size="7" fill="#5F5D56">• Computes dynamic MAC</text>
        <text x="12" y="116" font-family="sans-serif" font-size="7" fill="#5F5D56">• Increments chip ATC</text>
        <text x="12" y="126" font-family="sans-serif" font-size="6.5" fill="#5F6849">CLONING IMPOSSIBLE</text>

        <rect x="8" y="138" width="129" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="12" y="154" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">TIME: ~300 MS</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="170" y1="115" x2="190" y2="115" stroke="#5F6849" stroke-width="1.6" marker-end="url(#sum-arr-olive)"/>

      <!-- Stage 2: POS Terminal -->
      <g transform="translate(195, 30)">
        <rect width="145" height="175" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="145" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">2. MERCHANT POS</text>

        <rect x="8" y="32" width="129" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="12" y="46" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">APDU PARSER</text>
        <text x="12" y="58" font-family="sans-serif" font-size="7" fill="#5F5D56">• Reads card records</text>
        <text x="12" y="68" font-family="sans-serif" font-size="7" fill="#5F5D56">• Extracts ARQC &amp; PAN</text>

        <rect x="8" y="80" width="129" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="12" y="94" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">PACKET ASSEMBLY</text>
        <text x="12" y="106" font-family="sans-serif" font-size="7" fill="#5F5D56">• Encrypts via P2PE</text>
        <text x="12" y="116" font-family="sans-serif" font-size="7" fill="#5F5D56">• Formats ISO 8583 msg</text>
        <text x="12" y="126" font-family="sans-serif" font-size="6.5" fill="#5F5D56">Uplink to Acquirer</text>

        <rect x="8" y="138" width="129" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="12" y="154" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">TIME: ~100 MS</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="340" y1="115" x2="360" y2="115" stroke="#151515" stroke-width="1.6" marker-end="url(#sum-arr)"/>

      <!-- Stage 3: Acquirer Processor -->
      <g transform="translate(365, 30)">
        <rect width="140" height="175" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="140" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">3. ACQUIRER</text>

        <rect x="8" y="32" width="124" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="12" y="46" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">GATEWAY INGRESS</text>
        <text x="12" y="58" font-family="sans-serif" font-size="7" fill="#5F5D56">• Verifies merchant ID</text>
        <text x="12" y="68" font-family="sans-serif" font-size="7" fill="#5F5D56">• Assigns STAN tracer</text>

        <rect x="8" y="80" width="124" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="94" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">SCHEME ROUTING</text>
        <text x="12" y="106" font-family="sans-serif" font-size="7" fill="#5F5D56">• Detects brand BIN</text>
        <text x="12" y="116" font-family="sans-serif" font-size="7" fill="#5F5D56">• Forwards to Visa/MC</text>
        <text x="12" y="126" font-family="sans-serif" font-size="6.5" fill="#5F6849">Interbank network</text>

        <rect x="8" y="138" width="124" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="12" y="154" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">TIME: ~150 MS</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <line x1="505" y1="115" x2="525" y2="115" stroke="#151515" stroke-width="1.6" marker-end="url(#sum-arr)"/>

      <!-- Stage 4: Card Network Switch -->
      <g transform="translate(530, 30)">
        <rect width="135" height="175" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.5"/>
        <rect width="135" height="24" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">4. CARD SWITCH</text>

        <rect x="8" y="32" width="119" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="12" y="46" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">GLOBAL DIRECTORY</text>
        <text x="12" y="58" font-family="sans-serif" font-size="7" fill="#5F5D56">• BIN tables lookup</text>
        <text x="12" y="68" font-family="sans-serif" font-size="7" fill="#5F5D56">• De-tokenizes if DPAN</text>

        <rect x="8" y="80" width="119" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="94" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">CROSS-BORDER FIBER</text>
        <text x="12" y="106" font-family="sans-serif" font-size="7" fill="#5F5D56">• Transit to Issuer</text>
        <text x="12" y="116" font-family="sans-serif" font-size="7" fill="#5F5D56">• Stand-In backup check</text>
        <text x="12" y="126" font-family="sans-serif" font-size="6.5" fill="#5F6849">GLOBAL SWITCH</text>

        <rect x="8" y="138" width="119" height="26" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.6"/>
        <text x="12" y="154" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#5F6849">TIME: ~200 MS</text>
      </g>

      <!-- Arrow 4 -> 5 -->
      <line x1="665" y1="115" x2="685" y2="115" stroke="#5F6849" stroke-width="1.8" marker-end="url(#sum-arr-olive)"/>

      <!-- Stage 5: Issuing Bank Core -->
      <g transform="translate(690, 30)">
        <rect width="105" height="175" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.5"/>
        <rect width="105" height="24" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="8" y="16" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">5. ISSUER BANK</text>

        <rect x="6" y="32" width="93" height="42" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="8" y="46" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#5F6849">HSM CRYPTO</text>
        <text x="8" y="58" font-family="sans-serif" font-size="6.5" fill="#5F5D56">• ARQC valid</text>
        <text x="8" y="68" font-family="sans-serif" font-size="6.5" fill="#5F5D56">• Monotonic ATC</text>

        <rect x="6" y="80" width="93" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="8" y="94" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#5F6849">DECISION: 00</text>
        <text x="8" y="106" font-family="sans-serif" font-size="6.5" fill="#151515">• Balance hold</text>
        <text x="8" y="116" font-family="sans-serif" font-size="6.5" fill="#5F6849">• Auth 739201</text>
        <text x="8" y="126" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#5F6849">APPROVED</text>

        <rect x="6" y="138" width="93" height="26" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.6"/>
        <text x="8" y="154" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#5F6849">TIME: ~400 MS</text>
      </g>

      <!-- Bottom Note on Settlement -->
      <rect x="25" y="218" width="770" height="38" fill="#F4F1E9" stroke="#151515" stroke-width="0.8"/>
      <text x="35" y="234" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">AUTHORIZATION VS SETTLEMENT: </text>
      <text x="215" y="234" font-family="sans-serif" font-size="7.5" fill="#151515">Authorization locks funds in 2 seconds. Actual interbank money movement (clearing &amp; settlement)</text>
      <text x="35" y="248" font-family="sans-serif" font-size="7.5" fill="#5F5D56">occurs later according to network and institutional arrangements in consolidated batch files.</text>
    </svg>
  </div>
</figure>
