---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط مختصر لرحلة تثبيت APK: من الحزمة إلى إدارة الحزم ثم صندوق الحماية' : 'Thumbnail diagram showing APK to Package Manager to App Sandbox transition'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 04 / مسار التثبيت' : 'FIGURE 04 / INSTALL PIPELINE'}
    </span>
    <span>
      {lang === 'ar' ? 'من ملف الحزمة إلى إدارة الحزم ثم صندوق الحماية المعزول' : 'APK Archive → Package Manager → App Sandbox'}
    </span>
  </div>

  <div class="diagram-svg-container">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 640px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="thumb-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12" />
        </pattern>
        <pattern id="thumb-olive-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.75" stroke-opacity="0.2" />
        </pattern>
        <marker id="thumb-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515" />
        </marker>
        <marker id="thumb-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849" />
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25" />

      <!-- Corner Accents -->
      <line x1="8" y1="24" x2="8" y2="8" stroke="#151515" stroke-width="2" />
      <line x1="8" y1="8" x2="24" y2="8" stroke="#151515" stroke-width="2" />
      <line x1="812" y1="256" x2="812" y2="272" stroke="#151515" stroke-width="2" />
      <line x1="812" y1="272" x2="796" y2="272" stroke="#151515" stroke-width="2" />

      <!-- STAGE 1: APK PACKAGE -->
      <g transform="translate(25, 30)">
        <rect width="215" height="185" fill="#F4F1E9" stroke="#151515" stroke-width="1.4" />
        <rect width="215" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="1" />
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">01 / APK ARCHIVE</text>

        <rect x="12" y="38" width="191" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="52" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">ZIP CONTAINER</text>
        <text x="18" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• AndroidManifest.xml (Binary)</text>
        <text x="18" y="80" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• classes.dex (Bytecode)</text>

        <rect x="12" y="98" width="191" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8" />
        <text x="18" y="112" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">SIGNING BLOCK</text>
        <text x="18" y="126" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Cryptographic cert hash</text>
        <text x="18" y="140" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Validates file integrity</text>

        <rect x="12" y="156" width="191" height="20" fill="url(#thumb-hatch)" stroke="#151515" stroke-width="0.5" />
        <text x="16" y="169" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">State: Unexecuted File</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <path d="M 240 122 L 275 122" stroke="#151515" stroke-width="1.6" marker-end="url(#thumb-arrow)" />

      <!-- STAGE 2: PACKAGE MANAGER (CORE) -->
      <g transform="translate(285, 30)">
        <rect width="245" height="185" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.8" />
        <rect width="245" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="1" />
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">02 / PACKAGE MANAGER</text>

        <rect x="12" y="38" width="221" height="62" fill="#FAF8F2" stroke="#5F6849" stroke-width="1" />
        <text x="18" y="52" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">PMS (system_server)</text>
        <text x="18" y="66" font-family="sans-serif" font-size="7.5" fill="#151515">✓ Verifies package signature</text>
        <text x="18" y="80" font-family="sans-serif" font-size="7.5" fill="#151515">✓ Parses component declarations</text>
        <text x="18" y="93" font-family="sans-serif" font-size="7.5" fill="#151515">✓ Commits to packages.xml</text>

        <rect x="12" y="108" width="221" height="42" fill="url(#thumb-olive-hatch)" stroke="#5F6849" stroke-width="0.8" />
        <text x="18" y="122" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">LINUX UID ALLOCATION</text>
        <text x="18" y="136" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">Assigns: u0_a142 (UID 10142)</text>

        <rect x="12" y="156" width="221" height="20" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.5" />
        <text x="16" y="169" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#5F6849">Calls native installd daemon</text>
      </g>

      <!-- Arrow 2 -> 3 (Olive) -->
      <path d="M 530 122 L 565 122" stroke="#5F6849" stroke-width="1.6" marker-end="url(#thumb-arrow-olive)" />

      <!-- STAGE 3: APP SANDBOX -->
      <g transform="translate(575, 30)">
        <rect width="220" height="185" fill="#FAF8F2" stroke="#151515" stroke-width="1.4" />
        <rect width="220" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="1" />
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">03 / APP SANDBOX</text>

        <rect x="12" y="38" width="196" height="52" fill="#F4F1E9" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="52" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">FILESYSTEM ISOLATION</text>
        <text x="18" y="66" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">/data/user/0/com.app/</text>
        <text x="18" y="80" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Mode: drwx------ (0700)</text>

        <rect x="12" y="98" width="196" height="52" fill="#F4F1E9" stroke="#5F6849" stroke-width="0.8" />
        <text x="18" y="112" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">KERNEL BOUNDARY</text>
        <text x="18" y="126" font-family="sans-serif" font-size="7.5" fill="#151515">• Other UIDs blocked (EACCES)</text>
        <text x="18" y="140" font-family="sans-serif" font-size="7.5" fill="#151515">• SELinux untrusted_app rules</text>

        <rect x="12" y="156" width="196" height="20" fill="#EBE7DE" stroke="#151515" stroke-width="0.5" />
        <text x="16" y="169" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">Awaiting Launch Signal</text>
      </g>

      <!-- Bottom Principle Banner -->
      <g transform="translate(25, 226)">
        <rect width="770" height="32" fill="#EBE7DE" stroke="#151515" stroke-width="1" />
        <rect x="4" y="4" width="6" height="24" fill="#5F6849" />
        <text x="20" y="21" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#151515" letter-spacing="0.06em">
          CORE FLOW: APK Archive → PackageManagerService Validation → Linux UID &amp; App Sandbox Creation
        </text>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 04: مسار التثبيت — الحزمة تُفحص بواسطة PackageManagerService لتثبيت هوية المطور وتخصيص UID لنظام الملفات المعزول.'
      : 'Figure 04: The installation pipeline — APK archive is validated by PackageManagerService, assigning a dedicated Linux UID to an isolated sandbox.'}
  </figcaption>
</figure>
