---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط البطاقة اللاتلامسية، جهاز الدفع، ومحفظة الهاتف الذكي' : 'Visual diagram showing contactless card, POS terminal, and phone wallet'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 06 / الدفع اللاتلامسي' : 'FIGURE 06 / CONTACTLESS PAYMENT'}
    </span>
    <span>
      {lang === 'ar' ? 'بطاقة ذكية ومحفظة الهاتف ← اتصال NFC ← جهاز نقاط البيع' : 'Contactless Card & Phone Wallet → NFC Tap → POS Terminal'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 640px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="pay-th-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <pattern id="pay-th-olive-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.75" stroke-opacity="0.25"/>
        </pattern>
        <marker id="pay-th-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="pay-th-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Corner Accents -->
      <line x1="8" y1="24" x2="8" y2="8" stroke="#151515" stroke-width="2"/>
      <line x1="8" y1="8" x2="24" y2="8" stroke="#151515" stroke-width="2"/>
      <line x1="812" y1="256" x2="812" y2="272" stroke="#151515" stroke-width="2"/>
      <line x1="812" y1="272" x2="796" y2="272" stroke="#151515" stroke-width="2"/>

      <!-- ============================================== -->
      <!-- 01 / LEFT OBJECT: PHYSICAL CONTACTLESS CARD    -->
      <!-- ============================================== -->
      <g transform="translate(30, 32)">
        <!-- Card Body -->
        <rect width="235" height="152" rx="10" fill="#F4F1E9" stroke="#151515" stroke-width="1.8"/>

        <!-- Embedded Copper Perimeter Antenna Trace -->
        <rect x="10" y="10" width="215" height="132" rx="7" fill="none" stroke="#5F6849" stroke-width="1.2" stroke-dasharray="4 2"/>
        <rect x="14" y="14" width="207" height="124" rx="5" fill="none" stroke="#5F6849" stroke-width="0.8" stroke-dasharray="4 2" stroke-opacity="0.5"/>

        <!-- EMV Smart Chip Microcontroller -->
        <g transform="translate(28, 42)">
          <rect width="46" height="38" rx="3" fill="#EBE7DE" stroke="#151515" stroke-width="1.2"/>
          <!-- Chip Contacts Pattern -->
          <line x1="0" y1="19" x2="46" y2="19" stroke="#151515" stroke-width="0.8"/>
          <line x1="16" y1="0" x2="16" y2="38" stroke="#151515" stroke-width="0.8"/>
          <line x1="30" y1="0" x2="30" y2="38" stroke="#151515" stroke-width="0.8"/>
          <circle cx="23" cy="19" r="5" fill="#5F6849" fill-opacity="0.25" stroke="#5F6849" stroke-width="0.9"/>
        </g>
        <text x="32" y="94" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">EMV CHIP</text>

        <!-- Contactless Wave Icon on Card -->
        <g transform="translate(186, 32)">
          <path d="M 6 26 A 16 16 0 0 1 6 6" fill="none" stroke="#151515" stroke-width="2"/>
          <path d="M 12 30 A 24 24 0 0 1 12 2" fill="none" stroke="#151515" stroke-width="2"/>
          <path d="M 18 34 A 32 32 0 0 1 18 -2" fill="none" stroke="#151515" stroke-width="2"/>
        </g>

        <!-- Embossed PAN & Card Details -->
        <text x="28" y="118" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#151515">•••• •••• •••• 8492</text>
        <text x="28" y="134" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">MOUHIB MH • 09/29</text>

        <!-- Label below card -->
        <text x="117" y="180" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">
          {lang === 'ar' ? '01 / بطاقة بنكية لا تلامسية' : '01 / CONTACTLESS CARD'}
        </text>
        <text x="117" y="194" text-anchor="middle" font-family="sans-serif" font-size="7" fill="#5F5D56">
          {lang === 'ar' ? 'حث كهرومغناطيسي 13.56MHz' : '13.56 MHz Inductive Coupling'}
        </text>
      </g>

      <!-- ============================================== -->
      <!-- NFC WAVES (CARD -> POS)                        -->
      <!-- ============================================== -->
      <g transform="translate(268, 95)">
        <path d="M 6 0 A 18 18 0 0 1 6 36" fill="none" stroke="#5F6849" stroke-width="1.8" stroke-dasharray="3 2"/>
        <path d="M 16 -6 A 28 28 0 0 1 16 42" fill="none" stroke="#5F6849" stroke-width="1.8" stroke-dasharray="3 2"/>
        <path d="M 26 -12 A 38 38 0 0 1 26 48" fill="none" stroke="#5F6849" stroke-width="1.8" stroke-dasharray="3 2"/>
        <text x="18" y="65" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">NFC</text>
      </g>

      <!-- ============================================== -->
      <!-- 02 / CENTER OBJECT: MERCHANT POS TERMINAL      -->
      <!-- ============================================== -->
      <g transform="translate(310, 20)">
        <!-- Terminal Body -->
        <rect width="200" height="240" rx="10" fill="#F4F1E9" stroke="#151515" stroke-width="1.8"/>

        <!-- Top Tap Landing Zone with 4 EMV LEDs -->
        <rect x="14" y="12" width="172" height="42" rx="4" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        
        <!-- 4 Illuminated EMV Green/Olive LEDs -->
        <circle cx="68" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="89" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="110" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="131" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>

        <!-- High-Contrast Terminal Display Screen -->
        <rect x="14" y="62" width="172" height="72" rx="4" fill="#FAF8F2" stroke="#151515" stroke-width="1.2"/>
        <text x="24" y="82" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">TOTAL: $ 24.50 USD</text>
        <g transform="translate(24, 94)">
          <rect width="92" height="18" rx="2" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.8"/>
          <text x="6" y="13" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">
            APPROVED ✓
          </text>
        </g>
        <text x="24" y="125" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#5F5D56">EMV L2 • ARQC 0x7F2A</text>

        <!-- Terminal Physical Keypad -->
        <rect x="14" y="142" width="172" height="66" rx="4" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <!-- Keypad Buttons -->
        <g fill="#FAF8F2" stroke="#151515" stroke-width="0.6">
          <rect x="24" y="148" width="42" height="16" rx="2"/>
          <rect x="79" y="148" width="42" height="16" rx="2"/>
          <rect x="134" y="148" width="42" height="16" rx="2"/>
          <rect x="24" y="168" width="42" height="16" rx="2"/>
          <rect x="79" y="168" width="42" height="16" rx="2"/>
          <rect x="134" y="168" width="42" height="16" rx="2"/>
          <rect x="24" y="188" width="42" height="16" rx="2"/>
          <rect x="79" y="188" width="42" height="16" rx="2"/>
          <rect x="134" y="188" width="42" height="16" rx="2" fill="#5F6849"/>
        </g>
        <text x="42" y="160" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">1</text>
        <text x="97" y="160" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">2</text>
        <text x="152" y="160" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">3</text>
        <text x="148" y="200" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#FAF8F2">OK</text>

        <!-- Terminal Footer Label -->
        <text x="100" y="222" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">
          {lang === 'ar' ? '02 / جهاز نقاط البيع (POS)' : '02 / POS TERMINAL'}
        </text>
      </g>

      <!-- ============================================== -->
      <!-- NFC WAVES (PHONE -> POS)                       -->
      <!-- ============================================== -->
      <g transform="translate(525, 95)">
        <path d="M 26 0 A 18 18 0 0 0 26 36" fill="none" stroke="#5F6849" stroke-width="1.8" stroke-dasharray="3 2"/>
        <path d="M 16 -6 A 28 28 0 0 0 16 42" fill="none" stroke="#5F6849" stroke-width="1.8" stroke-dasharray="3 2"/>
        <path d="M 6 -12 A 38 38 0 0 0 6 48" fill="none" stroke="#5F6849" stroke-width="1.8" stroke-dasharray="3 2"/>
        <text x="16" y="65" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">NFC</text>
      </g>

      <!-- ============================================== -->
      <!-- 03 / RIGHT OBJECT: SMARTPHONE WALLET           -->
      <!-- ============================================== -->
      <g transform="translate(565, 24)">
        <!-- Phone Outer Body -->
        <rect width="220" height="232" rx="16" fill="#F4F1E9" stroke="#151515" stroke-width="1.8"/>

        <!-- Speaker Slit & Front Camera Sensor -->
        <rect x="85" y="7" width="50" height="4" rx="2" fill="#151515" fill-opacity="0.3"/>
        <circle cx="145" cy="9" r="2.5" fill="#151515" fill-opacity="0.4"/>

        <!-- Phone Screen Bezel -->
        <rect x="8" y="18" width="204" height="196" rx="8" fill="#FAF8F2" stroke="#151515" stroke-width="1"/>

        <!-- Wallet Top Bar -->
        <text x="18" y="34" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">
          {lang === 'ar' ? 'المحفظة الرقمية' : 'PHONE WALLET'}
        </text>

        <!-- Digital Card Representation on Phone Screen -->
        <g transform="translate(18, 44)">
          <rect width="184" height="98" rx="7" fill="#EBE7DE" stroke="#5F6849" stroke-width="1.4"/>
          
          <!-- Card Decorative Header -->
          <circle cx="20" cy="20" r="7" fill="#5F6849" fill-opacity="0.3"/>
          <text x="34" y="24" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">DIGITAL PASS</text>
          
          <!-- Virtual Contactless Symbol -->
          <g transform="translate(155, 12)">
            <path d="M 4 16 A 10 10 0 0 1 4 4" fill="none" stroke="#151515" stroke-width="1.5"/>
            <path d="M 8 18 A 14 14 0 0 1 8 2" fill="none" stroke="#151515" stroke-width="1.5"/>
          </g>

          <!-- Masked Tokenized DPAN -->
          <text x="16" y="58" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#151515">•••• 9104</text>
          <text x="16" y="72" font-family="'JetBrains Mono', monospace" font-size="6.5" font-weight="600" fill="#5F6849">TOKENIZED DPAN (eSE)</text>
          <text x="16" y="85" font-family="sans-serif" font-size="6.5" fill="#5F5D56">Real card PAN never exposed</text>
        </g>

        <!-- Biometric Authentication Badge below card -->
        <g transform="translate(30, 154)">
          <circle cx="16" cy="16" r="14" fill="#5F6849" stroke="#151515" stroke-width="1"/>
          <!-- Checkmark Icon -->
          <path d="M 9 16 L 14 21 L 23 11" fill="none" stroke="#FAF8F2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="38" y="15" font-family="-apple-system, sans-serif" font-size="8.5" font-weight="700" fill="#151515">
            {lang === 'ar' ? 'تم التحقق الحيوي' : 'Done'}
          </text>
          <text x="38" y="27" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#5F6849">
            CDCVM • Face ID / Touch ID
          </text>
        </g>

        <!-- Label below phone -->
        <text x="110" y="224" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">
          {lang === 'ar' ? '03 / محفظة الهاتف' : '03 / PHONE WALLET'}
        </text>
      </g>
    </svg>
  </div>
</figure>
