---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط حدود الثقة في وثائق الحامل (Bearer Credentials)' : 'Bearer token trust boundary model diagram'}>
  <div class="diagram-header">
    <span class="diagram-tag">{lang === 'ar' ? 'مخطط 04 / نموذج الثقة' : 'FIGURE 04 / TRUST BOUNDARY'}</span>
    <span>{lang === 'ar' ? 'السيرفر لا يرى الهوية الفيزيائية' : 'THE BLINDNESS OF BEARER TOKENS'}</span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 800 280" width="100%" height="auto" style="min-width: 650px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="trust-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="trust-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <rect x="8" y="8" width="784" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- BROWSER A (LEGITIMATE) -->
      <g transform="translate(30, 30)">
        <rect width="210" height="95" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="210" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="10" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">BROWSER A (ORIGINAL OWNER)</text>
        <text x="12" y="42" font-family="sans-serif" font-size="9" fill="#151515">Human: Mouhib</text>
        <text x="12" y="58" font-family="sans-serif" font-size="8" fill="#5F5D56">IP: 192.0.2.45 (Home WiFi)</text>
        <rect x="10" y="66" width="190" height="20" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="16" y="80" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#5F6849">TOKEN: [session_id=ABC]</text>
      </g>

      <!-- BROWSER B (CLONED / ATTACKER) -->
      <g transform="translate(30, 155)">
        <rect width="210" height="95" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="210" height="22" fill="#E2DDD2" stroke="#151515" stroke-width="1"/>
        <text x="10" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#8F2D2D">BROWSER B (UNAUTHORIZED)</text>
        <text x="12" y="42" font-family="sans-serif" font-size="9" fill="#8F2D2D">Human: Adversary / Infostealer</text>
        <text x="12" y="58" font-family="sans-serif" font-size="8" fill="#5F5D56">IP: 198.51.100.12 (VPN exit node)</text>
        <rect x="10" y="66" width="190" height="20" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="16" y="80" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#5F6849">TOKEN: [session_id=ABC]</text>
      </g>

      <!-- Arrows to Central Server -->
      <path d="M 240 77 L 410 125" stroke="#151515" stroke-width="1.5" marker-end="url(#trust-arrow)"/>
      <path d="M 240 202 L 410 155" stroke="#151515" stroke-width="1.5" marker-end="url(#trust-arrow)"/>

      <!-- CENTRAL SERVER VERIFICATION EYE -->
      <g transform="translate(420, 50)">
        <rect width="340" height="180" fill="#F4F1E9" stroke="#151515" stroke-width="1.6"/>
        <rect width="340" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="12" y="18" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#151515">SERVER OBSERVATION PERCEPTION</text>

        <!-- What server DOES NOT see -->
        <rect x="15" y="38" width="310" height="42" fill="#FAF8F2" stroke="#8F2D2D" stroke-width="0.8" stroke-dasharray="2 2"/>
        <text x="24" y="54" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#8F2D2D">CANNOT PERCEIVE:</text>
        <text x="24" y="68" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Physical human identity, keyboard biometric rhythm, or intent.</text>

        <!-- What server DOES see -->
        <rect x="15" y="90" width="310" height="70" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.2"/>
        <text x="24" y="106" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">CAN ONLY EVALUATE:</text>
        <text x="24" y="122" font-family="'JetBrains Mono', monospace" font-size="8" fill="#151515">Incoming Token == 'session_id=ABC'</text>
        <text x="24" y="138" font-family="sans-serif" font-size="8" font-weight="600" fill="#5F6849">CONCLUSION: BOTH REQUESTS ARE 'MOUHIB'</text>
        <text x="24" y="152" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Possession equals identity under standard bearer cookie schemes.</text>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 04: نموذج وثيقة الحامل (Bearer) — السيرفر يطابق الرمز فقط. من يملك الرمز، يملك الجلسة أمام النظام البرمجي.'
      : 'Figure 04: The bearer paradigm — the server matches the token value alone; possession constitutes authorization.'}
  </figcaption>
</figure>
