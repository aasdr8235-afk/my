---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'ملامسة البطاقة لجهاز الدفع والمجال الكهرومغناطيسي' : 'Contactless card tap on payment terminal showing electromagnetic coupling'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط عام / التلامس الكهرومغناطيسي' : 'OVERVIEW / PHYSICAL TAP'}
    </span>
    <span>
      {lang === 'ar' ? 'تقريب البطاقة من جهاز الدفع وتوليد الطاقة الحثية' : 'Inductive coupling between terminal antenna and smart card'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 290" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="tap-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <pattern id="tap-olive-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.75" stroke-opacity="0.2"/>
        </pattern>
        <marker id="tap-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="tap-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="274" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Object Left: Contactless Smart Card (Physical Object) -->
      <g transform="translate(35, 30)">
        <!-- Card Body -->
        <rect width="260" height="165" rx="8" fill="#F4F1E9" stroke="#151515" stroke-width="1.6"/>
        
        <!-- Internal Antenna Coil Outline -->
        <rect x="10" y="10" width="240" height="145" rx="6" fill="none" stroke="#5F6849" stroke-width="1.2" stroke-dasharray="4 2"/>
        <rect x="14" y="14" width="232" height="137" rx="4" fill="none" stroke="#5F6849" stroke-width="0.8" stroke-dasharray="4 2" stroke-opacity="0.6"/>

        <!-- Contactless Chip / Secure Microcontroller -->
        <rect x="35" y="45" width="48" height="38" rx="3" fill="#EBE7DE" stroke="#151515" stroke-width="1.2"/>
        <circle cx="59" cy="64" r="6" fill="#5F6849" fill-opacity="0.25" stroke="#5F6849" stroke-width="1"/>
        <text x="38" y="98" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">EMV CHIP</text>

        <!-- Wave Symbol (Contactless Indicator) -->
        <g transform="translate(195, 25)">
          <path d="M 10 30 A 18 18 0 0 1 10 6" fill="none" stroke="#151515" stroke-width="2"/>
          <path d="M 18 34 A 26 26 0 0 1 18 2" fill="none" stroke="#151515" stroke-width="2"/>
          <path d="M 26 38 A 34 34 0 0 1 26 -2" fill="none" stroke="#151515" stroke-width="2"/>
        </g>

        <!-- Card PAN Mask & Branding -->
        <text x="35" y="125" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#151515">•••• •••• •••• 8492</text>
        <text x="35" y="142" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">CONTACTLESS SMART CARD</text>

        <!-- Annotation below card -->
        <text x="15" y="190" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#151515">No Internal Battery</text>
        <text x="15" y="204" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Copper loop harvests energy via induction</text>
      </g>

      <!-- Middle: The 13.56 MHz Magnetic Field & Proximity Gap -->
      <g transform="translate(315, 30)">
        <rect width="180" height="215" fill="#FAF8F2" stroke="#5F6849" stroke-width="1" stroke-dasharray="3 3"/>
        
        <text x="25" y="25" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">INDUCTIVE COUPLING</text>
        <text x="18" y="42" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">13.56 MHz Carrier Wave</text>

        <!-- Magnetic Field Lines (Arcs) -->
        <g transform="translate(90, 110)">
          <circle cx="0" cy="0" r="25" fill="none" stroke="#5F6849" stroke-width="1.2" stroke-dasharray="3 2"/>
          <circle cx="0" cy="0" r="45" fill="none" stroke="#5F6849" stroke-width="1.2" stroke-dasharray="3 2" stroke-opacity="0.8"/>
          <circle cx="0" cy="0" r="65" fill="none" stroke="#5F6849" stroke-width="1.2" stroke-dasharray="3 2" stroke-opacity="0.5"/>
          <circle cx="0" cy="0" r="85" fill="none" stroke="#5F6849" stroke-width="1.2" stroke-dasharray="3 2" stroke-opacity="0.3"/>
        </g>

        <!-- Range Label -->
        <rect x="25" y="150" width="130" height="45" fill="#F4F1E9" stroke="#151515" stroke-width="0.8"/>
        <text x="35" y="167" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">PROXIMITY GAP</text>
        <text x="35" y="182" font-family="sans-serif" font-size="7" fill="#5F5D56">Typically very short range</text>
        <text x="35" y="192" font-family="sans-serif" font-size="7" fill="#5F5D56">(a few centimeters)</text>
      </g>

      <!-- Object Right: Merchant POS Terminal (Physical Object) -->
      <g transform="translate(515, 30)">
        <!-- Terminal Body -->
        <rect width="270" height="215" rx="8" fill="#F4F1E9" stroke="#151515" stroke-width="1.6"/>
        
        <!-- Top Contactless Tap Area with LEDs -->
        <rect x="15" y="12" width="240" height="42" rx="4" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        
        <!-- 4 EMV Contactless Status LEDs -->
        <circle cx="95" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="120" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="145" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="170" cy="33" r="5" fill="#5F6849" stroke="#151515" stroke-width="1"/>

        <!-- Terminal Screen -->
        <rect x="15" y="62" width="240" height="75" fill="#FAF8F2" stroke="#151515" stroke-width="1.2"/>
        <text x="25" y="82" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">TOTAL: $ 24.50 USD</text>
        <text x="25" y="100" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">PLEASE TAP OR INSERT CARD</text>
        <text x="25" y="118" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">Terminal ID: POS_88301 • ISO 14443</text>

        <!-- Keypad area representation -->
        <rect x="15" y="145" width="240" height="60" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <g fill="#FAF8F2" stroke="#151515" stroke-width="0.6">
          <rect x="25" y="152" width="60" height="20" rx="2"/>
          <rect x="105" y="152" width="60" height="20" rx="2"/>
          <rect x="185" y="152" width="60" height="20" rx="2"/>
          <rect x="25" y="177" width="60" height="20" rx="2"/>
          <rect x="105" y="177" width="60" height="20" rx="2"/>
          <rect x="185" y="177" width="60" height="20" rx="2"/>
        </g>
        <text x="48" y="166" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">1</text>
        <text x="130" y="166" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">2</text>
        <text x="210" y="166" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">3</text>
      </g>
    </svg>
  </div>
</figure>
