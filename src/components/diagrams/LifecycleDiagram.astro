---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط دورة حياة الجلسة الكاملة' : 'Complete horizontal session lifecycle diagram'}>
  <div class="diagram-header">
    <span class="diagram-tag">{lang === 'ar' ? 'مخطط 08 / دورة الحياة' : 'FIGURE 08 / LIFECYCLE'}</span>
    <span>{lang === 'ar' ? 'سلسلة إدارة الجلسة من الإنشاء إلى الإلغاء' : 'SESSION PIPELINE: CREATE TO REVOKE'}</span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 840 210" width="100%" height="auto" style="min-width: 700px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="life-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="life-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <rect x="8" y="8" width="824" height="194" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- 6 STAGES OF THE LIFECYCLE -->

      <!-- Stage 1: CREATE -->
      <g transform="translate(20, 30)">
        <rect width="115" height="145" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="115" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="8" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">1. CREATE</text>
        <g transform="translate(8, 38)">
          <text x="0" y="8" font-family="sans-serif" font-size="8" font-weight="600" fill="#151515">Entropy Gen</text>
          <text x="0" y="24" font-family="sans-serif" font-size="7" fill="#5F5D56">128+ bits CSPRNG</text>
          <text x="0" y="38" font-family="sans-serif" font-size="7" fill="#5F5D56">Unpredictable ID</text>
          <text x="0" y="58" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">Hash before save</text>
        </g>
      </g>

      <path d="M 135 100 L 155 100" stroke="#151515" stroke-width="1.3" marker-end="url(#life-arrow)"/>

      <!-- Stage 2: USE -->
      <g transform="translate(155, 30)">
        <rect width="115" height="145" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="115" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="8" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">2. USE</text>
        <g transform="translate(8, 38)">
          <text x="0" y="8" font-family="sans-serif" font-size="8" font-weight="600" fill="#151515">Transport</text>
          <text x="0" y="24" font-family="sans-serif" font-size="7" fill="#5F5D56">HTTPS only</text>
          <text x="0" y="38" font-family="sans-serif" font-size="7" fill="#5F5D56">HttpOnly guarded</text>
          <text x="0" y="58" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">Update last_seen</text>
        </g>
      </g>

      <path d="M 270 100 L 290 100" stroke="#151515" stroke-width="1.3" marker-end="url(#life-arrow)"/>

      <!-- Stage 3: ROTATE -->
      <g transform="translate(290, 30)">
        <rect width="115" height="145" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="115" height="22" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="8" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">3. ROTATE</text>
        <g transform="translate(8, 38)">
          <text x="0" y="8" font-family="sans-serif" font-size="8" font-weight="600" fill="#151515">ID Refresh</text>
          <text x="0" y="24" font-family="sans-serif" font-size="7" fill="#5F5D56">On privilege shift</text>
          <text x="0" y="38" font-family="sans-serif" font-size="7" fill="#5F5D56">Periodic 15-30m</text>
          <text x="0" y="58" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#5F6849">Old ID invalidated</text>
        </g>
      </g>

      <path d="M 405 100 L 425 100" stroke="#5F6849" stroke-width="1.3" marker-end="url(#life-arrow-olive)"/>

      <!-- Stage 4: REAUTH -->
      <g transform="translate(425, 30)">
        <rect width="115" height="145" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="115" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="8" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">4. REAUTH</text>
        <g transform="translate(8, 38)">
          <text x="0" y="8" font-family="sans-serif" font-size="8" font-weight="600" fill="#151515">Step-up Gate</text>
          <text x="0" y="24" font-family="sans-serif" font-size="7" fill="#5F5D56">On password change</text>
          <text x="0" y="38" font-family="sans-serif" font-size="7" fill="#5F5D56">On critical transfers</text>
          <text x="0" y="58" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">Demand password</text>
        </g>
      </g>

      <path d="M 540 100 L 560 100" stroke="#151515" stroke-width="1.3" marker-end="url(#life-arrow)"/>

      <!-- Stage 5: EXPIRE -->
      <g transform="translate(560, 30)">
        <rect width="115" height="145" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="115" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="8" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">5. EXPIRE</text>
        <g transform="translate(8, 38)">
          <text x="0" y="8" font-family="sans-serif" font-size="8" font-weight="600" fill="#151515">Timeouts</text>
          <text x="0" y="24" font-family="sans-serif" font-size="7" fill="#5F5D56">Idle: 30 min</text>
          <text x="0" y="38" font-family="sans-serif" font-size="7" fill="#5F5D56">Absolute: 12-24h</text>
          <text x="0" y="58" font-family="'JetBrains Mono', monospace" font-size="7" fill="#8F2D2D">Automatic death</text>
        </g>
      </g>

      <path d="M 675 100 L 695 100" stroke="#151515" stroke-width="1.3" marker-end="url(#life-arrow)"/>

      <!-- Stage 6: REVOKE -->
      <g transform="translate(695, 30)">
        <rect width="120" height="145" fill="#FAF8F2" stroke="#8F2D2D" stroke-width="1.4"/>
        <rect width="120" height="22" fill="#E2DDD2" stroke="#8F2D2D" stroke-width="1"/>
        <text x="8" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#8F2D2D">6. REVOKE</text>
        <g transform="translate(8, 38)">
          <text x="0" y="8" font-family="sans-serif" font-size="8" font-weight="600" fill="#8F2D2D">Purge State</text>
          <text x="0" y="24" font-family="sans-serif" font-size="7" fill="#5F5D56">Explicit user logout</text>
          <text x="0" y="38" font-family="sans-serif" font-size="7" fill="#5F5D56">Global session kill</text>
          <text x="0" y="58" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#8F2D2D">DEL session:*</text>
        </g>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 08: دورة حياة الجلسة المتكاملة: الإنشاء العشوائي ← الاستخدام المشفر ← التدوير الدوري ← إعادة التحقق للعمليات الحساسة ← انتهاء الصلاحية ← الإلغاء الشامل.'
      : 'Figure 08: The complete 6-stage session lifecycle pipeline: Create → Use → Rotate → Reauth → Expire → Revoke.'}
  </figcaption>
</figure>
