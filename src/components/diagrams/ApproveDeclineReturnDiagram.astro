---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مسار العودة ورمز الموافقة وشاشة جهاز الدفع' : 'Return path of authorization code and terminal display update'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 08 / مسار العودة' : 'FIGURE 08 / THE RETURN PATH'}
    </span>
    <span>
      {lang === 'ar' ? 'عودة رمز الموافقة، إضاءة الأضواء الخضراء وصفارة التأكيد' : 'Issuer Approval Code → Network → Acquirer → Terminal "APPROVED" beep'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="ret-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="ret-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="ret-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Reverse Flow (Right to Left conceptually) -->

      <!-- Step 1: Issuer Emits Response (Right) -->
      <g transform="translate(585, 30)">
        <rect width="210" height="215" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.4"/>
        <rect width="210" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">1. ISSUER EMITS RESPONSE</text>

        <rect x="10" y="36" width="190" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="50" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">RESPONSE CODE: 00</text>
        <text x="14" y="64" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">AUTH CODE: 739201</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7" fill="#5F5D56">Funds locked ($24.50)</text>

        <rect x="10" y="96" width="190" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">DISPATCH VIA SCHEME</text>
        <text x="14" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Injected into Visa / MC switch</text>
        <text x="14" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Forwarded to Acquirer</text>

        <rect x="10" y="156" width="190" height="42" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.6"/>
        <text x="14" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#5F6849">LATENCY: ~150-350 MS</text>
        <text x="14" y="186" font-family="sans-serif" font-size="7" fill="#5F5D56">Return trip across global fiber</text>
      </g>

      <!-- Arrow: Issuer -> Network -> Acquirer -->
      <line x1="585" y1="135" x2="525" y2="135" stroke="#5F6849" stroke-width="1.8" marker-end="url(#ret-arr-olive)"/>
      <text x="535" y="125" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">0110 Resp</text>

      <!-- Step 2: Acquirer Relays (Middle) -->
      <g transform="translate(305, 30)">
        <rect width="210" height="215" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="210" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">2. ACQUIRER RELAYS</text>

        <rect x="10" y="36" width="190" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="50" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">MATCH PENDING TRANSACTION</text>
        <text x="14" y="64" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Matches Systems Trace Audit No (STAN)</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Identifies open POS TLS connection</text>

        <rect x="10" y="96" width="190" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="110" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">RECORDS TRANSACTION</text>
        <text x="14" y="124" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Stores auth code for clearing batch</text>
        <text x="14" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Emits response down socket</text>

        <rect x="10" y="156" width="190" height="42" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">SOCKET DELIVERY</text>
        <text x="14" y="186" font-family="sans-serif" font-size="7" fill="#5F5D56">Returns to local retail register</text>
      </g>

      <!-- Arrow: Acquirer -> Terminal -->
      <line x1="305" y1="135" x2="245" y2="135" stroke="#5F6849" stroke-width="1.8" marker-end="url(#ret-arr-olive)"/>
      <text x="255" y="125" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">Auth OK</text>

      <!-- Step 3: Terminal Visual Feedback (Left - Primary Focus) -->
      <g transform="translate(25, 30)">
        <rect width="210" height="215" rx="6" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="210" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">3. TERMINAL UI & AUDIO</text>

        <!-- Simulated Screen (Approved) -->
        <rect x="10" y="34" width="190" height="66" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.2"/>
        <!-- Green indicator bar -->
        <rect x="10" y="34" width="190" height="8" fill="#5F6849"/>
        <text x="18" y="58" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700" fill="#5F6849">APPROVED</text>
        <text x="18" y="74" font-family="'JetBrains Mono', monospace" font-size="8" fill="#151515">AUTH: 739201</text>
        <text x="18" y="88" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">$ 24.50 • PLEASE REMOVE CARD</text>

        <!-- Beep & LED representation -->
        <rect x="10" y="108" width="190" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <circle cx="28" cy="129" r="6" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="48" cy="129" r="6" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="68" cy="129" r="6" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <circle cx="88" cy="129" r="6" fill="#5F6849" stroke="#151515" stroke-width="1"/>
        <text x="110" y="128" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">BEEP / TONE</text>
        <text x="110" y="140" font-family="sans-serif" font-size="7" fill="#5F5D56">4 Green LEDs lit</text>

        <rect x="10" y="156" width="190" height="42" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.6"/>
        <text x="16" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">TOTAL TIME ELAPSED: ~1.8 SEC</text>
        <text x="16" y="186" font-family="sans-serif" font-size="7" fill="#5F5D56">Customer walks away with purchased goods</text>
      </g>
    </svg>
  </div>
</figure>
