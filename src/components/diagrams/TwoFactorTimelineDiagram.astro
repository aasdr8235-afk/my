---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط زمني للمصادقة الثنائية مقابل مرحلة الجلسة المستمرة' : '2FA authentication phase vs established session timeline diagram'}>
  <div class="diagram-header">
    <span class="diagram-tag">{lang === 'ar' ? 'مخطط 06 / حدود 2FA' : 'FIGURE 06 / 2FA BOUNDARY'}</span>
    <span>{lang === 'ar' ? 'أين ينتهي دور المصادقة الثنائية؟' : 'AUTHENTICATION VS. POST-AUTH LIFE'}</span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 250" width="100%" height="auto" style="min-width: 660px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="mfa-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.75" stroke-opacity="0.2"/>
        </pattern>
        <marker id="mfa-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="mfa-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <rect x="8" y="8" width="804" height="234" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- PHASE 1: INITIAL AUTHENTICATION (WHERE 2FA LIVES) -->
      <g transform="translate(25, 30)">
        <rect width="250" height="185" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="250" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">PHASE 1: AUTHENTICATION</text>
        
        <!-- Steps inside Auth -->
        <g transform="translate(15, 38)">
          <text x="0" y="10" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">1. User submits Password</text>
          <path d="M 120 18 L 120 28" stroke="#151515" stroke-width="1" marker-end="url(#mfa-arrow)"/>
          
          <rect x="0" y="32" width="220" height="32" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.2"/>
          <text x="10" y="48" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">2. 2FA CHALLENGE (TOTP / FIDO)</text>
          <text x="10" y="58" font-family="sans-serif" font-size="7" fill="#5F5D56">MFA verified successfully</text>
          
          <path d="M 120 70 L 120 80" stroke="#5F6849" stroke-width="1" marker-end="url(#mfa-arrow-olive)"/>

          <rect x="0" y="85" width="220" height="42" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
          <text x="10" y="100" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">SESSION TOKEN GENERATED</text>
          <text x="10" y="114" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">session_id=valid_24h</text>
        </g>
      </g>

      <!-- Arrow Phase 1 -> Phase 2 -->
      <path d="M 275 120 L 315 120" stroke="#151515" stroke-width="1.5" marker-end="url(#mfa-arrow)"/>

      <!-- PHASE 2: ESTABLISHED SESSION (WHERE ATTACK OCCURS) -->
      <g transform="translate(325, 30)">
        <rect width="250" height="185" fill="#F4F1E9" stroke="#8F2D2D" stroke-width="1.4"/>
        <rect width="250" height="24" fill="#E2DDD2" stroke="#8F2D2D" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#8F2D2D">PHASE 2: ESTABLISHED SESSION</text>

        <g transform="translate(15, 38)">
          <text x="0" y="12" font-family="sans-serif" font-size="8.5" fill="#151515">Incoming Normal HTTP Requests:</text>
          
          <rect x="0" y="24" width="220" height="34" fill="#FAF8F2" stroke="#151515" stroke-width="0.8"/>
          <text x="8" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">GET /inbox /feed /messages</text>
          <text x="8" y="50" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">Cookie: session_id=valid</text>

          <rect x="0" y="70" width="220" height="65" fill="#FAF8F2" stroke="#8F2D2D" stroke-width="1.2"/>
          <text x="8" y="86" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#8F2D2D">THE CRITICAL BLINDSPOT:</text>
          <text x="8" y="100" font-family="sans-serif" font-size="7.5" fill="#5F5D56">The server does NOT prompt for 2FA</text>
          <text x="8" y="112" font-family="sans-serif" font-size="7.5" fill="#5F5D56">again on routine requests.</text>
          <text x="8" y="126" font-family="sans-serif" font-size="7.5" font-weight="600" fill="#8F2D2D">Stolen cookie bypasses 2FA barrier.</text>
        </g>
      </g>

      <!-- Arrow Phase 2 -> Phase 3 -->
      <path d="M 575 120 L 605 120" stroke="#5F6849" stroke-width="1.5" marker-end="url(#mfa-arrow-olive)"/>

      <!-- PHASE 3: STEP-UP MITIGATION -->
      <g transform="translate(615, 30)">
        <rect width="180" height="185" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="180" height="24" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="8" y="16" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">DEFENSE: STEP-UP</text>

        <g transform="translate(10, 38)">
          <text x="0" y="12" font-family="sans-serif" font-size="8" font-weight="600" fill="#151515">Sensitive Actions Guard:</text>
          
          <rect x="0" y="24" width="160" height="42" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
          <text x="6" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#8F2D2D">POST /change-password</text>
          <text x="6" y="50" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#8F2D2D">POST /transfer-funds</text>
          <text x="6" y="60" font-family="sans-serif" font-size="7" fill="#5F5D56">Requires fresh factor!</text>

          <rect x="0" y="76" width="160" height="55" fill="url(#mfa-hatch)" stroke="#5F6849" stroke-width="1"/>
          <text x="8" y="92" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">REAUTHENTICATION</text>
          <text x="8" y="106" font-family="sans-serif" font-size="7" fill="#151515">Blocks adversaries even</text>
          <text x="8" y="118" font-family="sans-serif" font-size="7" fill="#151515">with cloned session.</text>
        </g>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 06: المصادقة الثنائية (2FA) تحمي بوابة الدخول، لكنها لا تُطلب مجددًا مع كل طلب اعتيادي — وهنا يكمن الفرق بين حماية الدخول وحماية الجلسة المستمرة.'
      : 'Figure 06: 2FA gates the authentication perimeter once. Normal requests do not re-prompt MFA, requiring step-up reauthentication on critical actions.'}
  </figcaption>
</figure>
