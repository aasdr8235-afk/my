---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'تشريح خصائص الكوكي الأمنية' : 'Security flags anatomy of the Set-Cookie HTTP header'}>
  <div class="diagram-header">
    <span class="diagram-tag">{lang === 'ar' ? 'مخطط 07 / خصائص الكوكي' : 'FIGURE 07 / COOKIE FLAGS'}</span>
    <span>{lang === 'ar' ? 'خصائص الترويسة الأمنية الثلاث' : 'HTTP SET-COOKIE ATTRIBUTE MATRIX'}</span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 800 270" width="100%" height="auto" style="min-width: 640px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="flag-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.75" stroke-opacity="0.25"/>
        </pattern>
      </defs>

      <rect x="8" y="8" width="784" height="254" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- HEADER TOP WIRE STRIP -->
      <g transform="translate(25, 25)">
        <rect width="750" height="38" fill="#EBE7DE" stroke="#151515" stroke-width="1.2"/>
        <text x="14" y="24" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#151515">Set-Cookie:</text>
        <text x="105" y="24" font-family="'JetBrains Mono', monospace" font-size="9.5" fill="#8E8C84">session_id=a3f9e7c4;</text>
        <text x="270" y="24" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#5F6849">HttpOnly;</text>
        <text x="350" y="24" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#2B5777">Secure;</text>
        <text x="415" y="24" font-family="'JetBrains Mono', monospace" font-size="9.5" font-weight="700" fill="#8F2D2D">SameSite=Lax</text>
      </g>

      <!-- CARD 1: HTTPONLY -->
      <g transform="translate(25, 78)">
        <rect width="240" height="170" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.4"/>
        <rect width="240" height="24" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">01 / HTTPONLY</text>

        <g transform="translate(10, 36)">
          <text x="0" y="10" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">JavaScript Barrier</text>
          <text x="0" y="26" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Blocks document.cookie access from client scripts.</text>

          <rect x="0" y="38" width="220" height="34" fill="#FAF8F2" stroke="#151515" stroke-width="0.6"/>
          <text x="8" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#8F2D2D">console.log(document.cookie)</text>
          <text x="8" y="64" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">→ "" (empty string)</text>

          <rect x="0" y="80" width="220" height="38" fill="url(#flag-hatch)" stroke="#5F6849" stroke-width="0.8"/>
          <text x="8" y="96" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">PREVENTS:</text>
          <text x="8" y="108" font-family="sans-serif" font-size="7.5" fill="#151515">Direct XSS exfiltration of token.</text>
        </g>
      </g>

      <!-- CARD 2: SECURE -->
      <g transform="translate(280, 78)">
        <rect width="240" height="170" fill="#F4F1E9" stroke="#2B5777" stroke-width="1.4"/>
        <rect width="240" height="24" fill="#FAF8F2" stroke="#2B5777" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#2B5777">02 / SECURE</text>

        <g transform="translate(10, 36)">
          <text x="0" y="10" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">TLS / HTTPS Transport Only</text>
          <text x="0" y="26" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Browser forbids transmission over unencrypted HTTP.</text>

          <rect x="0" y="38" width="220" height="34" fill="#FAF8F2" stroke="#151515" stroke-width="0.6"/>
          <text x="8" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#8F2D2D">http://example.com → BLOCKED</text>
          <text x="8" y="64" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#2B5777">https://example.com → ALLOWED</text>

          <rect x="0" y="80" width="220" height="38" fill="#EBE7DE" stroke="#2B5777" stroke-width="0.8"/>
          <text x="8" y="96" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#2B5777">PREVENTS:</text>
          <text x="8" y="108" font-family="sans-serif" font-size="7.5" fill="#151515">Man-in-the-Middle (MitM) sniffing.</text>
        </g>
      </g>

      <!-- CARD 3: SAMESITE -->
      <g transform="translate(535, 78)">
        <rect width="240" height="170" fill="#F4F1E9" stroke="#8F2D2D" stroke-width="1.4"/>
        <rect width="240" height="24" fill="#FAF8F2" stroke="#8F2D2D" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#8F2D2D">03 / SAMESITE</text>

        <g transform="translate(10, 36)">
          <text x="0" y="10" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">Contextual Origin Boundary</text>
          <text x="0" y="26" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Controls cookie sending in cross-site requests.</text>

          <rect x="0" y="38" width="220" height="34" fill="#FAF8F2" stroke="#151515" stroke-width="0.6"/>
          <text x="8" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">Strict: Never on third-party link</text>
          <text x="8" y="64" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">Lax: Top-level safe navigations</text>

          <rect x="0" y="80" width="220" height="38" fill="#EBE7DE" stroke="#8F2D2D" stroke-width="0.8"/>
          <text x="8" y="96" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#8F2D2D">PREVENTS:</text>
          <text x="8" y="108" font-family="sans-serif" font-size="7.5" fill="#151515">Cross-Site Request Forgery (CSRF).</text>
        </g>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 07: خصائص الكوكي الأساسية — HttpOnly لمنع قراءة الجافاسكربت، Secure لقصر النقل على HTTPS، وSameSite لعزل الطلبات عبر المواقع.'
      : 'Figure 07: Essential cookie attributes — HttpOnly restricts DOM scripts, Secure enforces TLS transit, and SameSite governs cross-site context.'}
  </figcaption>
</figure>
