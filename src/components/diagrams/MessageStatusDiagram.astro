---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'المعنى التقني الموزع لحالات الرسالة: مرسلة ومستلمة ومقروءة' : 'Distributed state transitions: Sent, Delivered, and Read receipts'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 07 / حالات التسليم' : 'FIGURE 07 / DISTRIBUTED STATE TRANSITIONS'}
    </span>
    <span>
      {lang === 'ar' ? 'ماذا تعني علامات الصح تقنيًا في الأنظمة الموزعة؟' : 'Technical semantics of status receipts in distributed systems'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="st-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="st-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="st-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- State 1: Outbox / Pending -->
      <g transform="translate(25, 35)">
        <rect width="175" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="175" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">1. PENDING / OUTBOX</text>

        <!-- UI Icon Representation -->
        <rect x="12" y="38" width="151" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <circle cx="28" cy="59" r="8" fill="none" stroke="#5F5D56" stroke-width="1.4"/>
        <line x1="28" y1="55" x2="28" y2="59" stroke="#5F5D56" stroke-width="1.4"/>
        <line x1="28" y1="59" x2="33" y2="59" stroke="#5F5D56" stroke-width="1.4"/>
        <text x="44" y="58" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">LOCAL OUTBOX</text>
        <text x="44" y="70" font-family="sans-serif" font-size="7" fill="#5F5D56">Clock / Pending indicator</text>

        <rect x="12" y="90" width="151" height="58" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="10" y="104" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">SYSTEM MEANING</text>
        <text x="10" y="118" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Stored in local app DB</text>
        <text x="10" y="130" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Network socket establishing</text>
        <text x="10" y="142" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Awaiting socket send buffer</text>

        <rect x="12" y="158" width="151" height="38" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="10" y="174" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">Scope: Sender device only</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="200" y1="140" x2="225" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#st-arrow)"/>

      <!-- State 2: Sent (Server Ingested) -->
      <g transform="translate(230, 35)">
        <rect width="180" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="180" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">2. SENT (SERVER ACK)</text>

        <!-- UI Icon Representation -->
        <rect x="12" y="38" width="156" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <path d="M 22 60 L 27 65 L 36 53" fill="none" stroke="#5F5D56" stroke-width="1.8"/>
        <text x="44" y="58" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">SINGLE CHECK</text>
        <text x="44" y="70" font-family="sans-serif" font-size="7" fill="#5F5D56">Server Accepted status</text>

        <rect x="12" y="90" width="156" height="58" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="10" y="104" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">SYSTEM MEANING</text>
        <text x="10" y="118" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Ingested by edge gateway</text>
        <text x="10" y="130" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Stored or queued on infra</text>
        <text x="10" y="142" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Provider takes responsibility</text>

        <rect x="12" y="158" width="156" height="38" fill="url(#st-hatch)" stroke="#151515" stroke-width="0.6"/>
        <text x="10" y="174" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">Recipient hasn't received yet</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="410" y1="140" x2="435" y2="140" stroke="#5F6849" stroke-width="1.6" marker-end="url(#st-arrow-olive)"/>

      <!-- State 3: Delivered -->
      <g transform="translate(440, 35)">
        <rect width="180" height="210" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.5"/>
        <rect width="180" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">3. DELIVERED (DEVICE ACK)</text>

        <!-- UI Icon Representation -->
        <rect x="12" y="38" width="156" height="42" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <path d="M 20 60 L 25 65 L 34 53" fill="none" stroke="#5F5D56" stroke-width="1.8"/>
        <path d="M 26 60 L 31 65 L 40 53" fill="none" stroke="#5F5D56" stroke-width="1.8"/>
        <text x="48" y="58" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">DOUBLE CHECK</text>
        <text x="48" y="70" font-family="sans-serif" font-size="7" fill="#5F5D56">Device Delivery status</text>

        <rect x="12" y="90" width="156" height="58" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.7"/>
        <text x="10" y="104" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">SYSTEM MEANING</text>
        <text x="10" y="118" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Delivered to recipient device</text>
        <text x="10" y="130" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Client emitted receipt frame</text>
        <text x="10" y="142" font-family="sans-serif" font-size="7" fill="#5F5D56">• Note: doesn't imply user saw it</text>

        <rect x="12" y="158" width="156" height="38" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.6"/>
        <text x="10" y="174" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#5F6849">Hardware inbox confirmed</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <line x1="620" y1="140" x2="645" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#st-arrow)"/>

      <!-- State 4: Read Receipt -->
      <g transform="translate(650, 35)">
        <rect width="145" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="145" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="10" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">4. READ RECEIPT</text>

        <!-- UI Icon Representation -->
        <rect x="8" y="38" width="129" height="42" fill="#FAF8F2" stroke="#3498DB" stroke-width="0.8"/>
        <path d="M 18 60 L 23 65 L 32 53" fill="none" stroke="#3498DB" stroke-width="1.8"/>
        <path d="M 24 60 L 29 65 L 38 53" fill="none" stroke="#3498DB" stroke-width="1.8"/>
        <text x="44" y="58" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#3498DB">READ CHECK</text>
        <text x="44" y="70" font-family="sans-serif" font-size="7" fill="#5F5D56">Conversation viewed</text>

        <rect x="8" y="90" width="129" height="58" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="8" y="104" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">SYSTEM MEANING</text>
        <text x="8" y="118" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Conversation opened</text>
        <text x="8" y="130" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• If receipts enabled</text>
        <text x="8" y="142" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Read signal transmitted</text>

        <rect x="8" y="158" width="129" height="38" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="8" y="174" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">Final interaction state</text>
      </g>
    </svg>
  </div>
</figure>
