---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط مقارنة المفتاح بتصريح الجلسة' : 'Key vs Session Pass conceptual comparison diagram'}>
  <div class="diagram-header">
    <span class="diagram-tag">{lang === 'ar' ? 'مخطط 10 / المفهوم الختامي' : 'FIGURE 10 / FINAL SYNTHESIS'}</span>
    <span>{lang === 'ar' ? 'المفتاح يفتح الباب — التصريح يبقيك بالداخل' : 'KEY OPENS THE DOOR, SESSION PASS KEEPS YOU INSIDE'}</span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 800 220" width="100%" height="auto" style="min-width: 640px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="pass-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.8" stroke-opacity="0.25"/>
        </pattern>
        <marker id="pass-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="pass-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <rect x="8" y="8" width="784" height="204" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- BLOCK 1: KEY / PASSWORD -->
      <g transform="translate(30, 30)">
        <rect width="150" height="150" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="150" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">01 / THE KEY</text>
        
        <!-- Key Icon / Art -->
        <g transform="translate(45, 45)">
          <circle cx="20" cy="20" r="14" stroke="#151515" stroke-width="1.8"/>
          <circle cx="20" cy="20" r="7" stroke="#151515" stroke-width="1.2"/>
          <line x1="34" y1="20" x2="65" y2="20" stroke="#151515" stroke-width="2.5"/>
          <line x1="52" y1="20" x2="52" y2="28" stroke="#151515" stroke-width="2"/>
          <line x1="62" y1="20" x2="62" y2="30" stroke="#151515" stroke-width="2"/>
        </g>
        <text x="75" y="125" text-anchor="middle" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">Password &amp; MFA</text>
        <text x="75" y="140" text-anchor="middle" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Single moment gate</text>
      </g>

      <path d="M 180 105 L 215 105" stroke="#151515" stroke-width="1.5" marker-end="url(#pass-arrow)"/>

      <!-- BLOCK 2: THE DOOR / LOGIN -->
      <g transform="translate(220, 30)">
        <rect width="150" height="150" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="150" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">02 / THE DOOR</text>

        <!-- Door Art -->
        <g transform="translate(50, 42)">
          <rect width="50" height="70" fill="#FAF8F2" stroke="#151515" stroke-width="1.5"/>
          <circle cx="8" cy="40" r="2.5" fill="#151515"/>
          <line x1="0" y1="0" x2="50" y2="0" stroke="#151515" stroke-width="2"/>
        </g>
        <text x="75" y="128" text-anchor="middle" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">Authentication</text>
        <text x="75" y="142" text-anchor="middle" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Entry validation</text>
      </g>

      <path d="M 370 105 L 405 105" stroke="#5F6849" stroke-width="1.8" marker-end="url(#pass-arrow-olive)"/>

      <!-- BLOCK 3: SESSION PASS (BADGE / TOKEN) -->
      <g transform="translate(410, 30)">
        <rect width="170" height="150" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.8"/>
        <rect width="170" height="24" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">03 / THE VISITOR PASS</text>

        <!-- Pass Badge -->
        <g transform="translate(25, 38)">
          <rect width="120" height="60" fill="url(#pass-hatch)" stroke="#5F6849" stroke-width="1"/>
          <rect x="10" y="8" width="100" height="44" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
          <text x="16" y="24" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">SESSION ID</text>
          <text x="16" y="38" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">sid: a3f9e7c4...</text>
        </g>
        <text x="85" y="122" text-anchor="middle" font-family="sans-serif" font-size="8.5" font-weight="700" fill="#5F6849">Session Cookie</text>
        <text x="85" y="138" text-anchor="middle" font-family="sans-serif" font-size="7.5" fill="#151515">Bearer proof of presence</text>
      </g>

      <path d="M 580 105 L 615 105" stroke="#5F6849" stroke-width="1.5" marker-end="url(#pass-arrow-olive)"/>

      <!-- BLOCK 4: ACCOUNT / ROOM ACCESS -->
      <g transform="translate(620, 30)">
        <rect width="150" height="150" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="150" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">04 / THE ACCOUNT</text>

        <!-- Vault Icon -->
        <g transform="translate(45, 45)">
          <rect width="60" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="1.5"/>
          <circle cx="30" cy="25" r="12" stroke="#151515" stroke-width="1.2"/>
          <line x1="30" y1="18" x2="30" y2="32" stroke="#151515" stroke-width="1.2"/>
          <line x1="23" y1="25" x2="37" y2="25" stroke="#151515" stroke-width="1.2"/>
        </g>
        <text x="75" y="125" text-anchor="middle" font-family="sans-serif" font-size="8.5" font-weight="600" fill="#151515">Full Access</text>
        <text x="75" y="140" text-anchor="middle" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Persistent interaction</text>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 10: التلخيص النهائي — كلمة السر تُستخدم لفتح الباب، لكن تصريح الجلسة (Session Cookie) هو ما يُبقيك بالداخل. حماية التصريح لا تقل أهمية عن حماية المفتاح.'
      : 'Figure 10: Final conceptual synthesis — the password opens the perimeter door, but the session pass keeps you inside. Securing the pass is as vital as the key itself.'}
  </figcaption>
</figure>
