---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط هجوم اختطاف الجلسة ومبدأ ثقة السيرفر في المعرّف' : 'Session reuse and bearer token trust flow diagram'}>
  <div class="diagram-header">
    <span class="diagram-tag">{lang === 'ar' ? 'مخطط 00 / المبدأ المعماري' : 'FIGURE 00 / ARCHITECTURAL PRINCIPLE'}</span>
    <span>{lang === 'ar' ? 'نموذج الثقة في معرّف الجلسة' : 'SESSION IDENTIFIER TRUST MODEL'}</span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 840 440" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Technical Cross-Hatch Pattern -->
        <pattern id="hero-hatch" width="8" height="8" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="8" stroke="#151515" stroke-width="0.75" stroke-opacity="0.15"/>
        </pattern>
        <pattern id="olive-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.8" stroke-opacity="0.3"/>
        </pattern>
        <!-- Arrowhead Marker -->
        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Background Box with Technical Corners -->
      <rect x="10" y="10" width="820" height="420" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>
      <line x1="10" y1="25" x2="10" y2="10" stroke="#151515" stroke-width="2"/>
      <line x1="10" y1="10" x2="25" y2="10" stroke="#151515" stroke-width="2"/>
      <line x1="830" y1="415" x2="830" y2="430" stroke="#151515" stroke-width="2"/>
      <line x1="830" y1="430" x2="815" y2="430" stroke="#151515" stroke-width="2"/>

      <!-- SECTION 1: LEGITIMATE SESSION CREATION (UPPER PATH) -->
      <!-- Label Track A -->
      <text x="35" y="42" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600" fill="#5F5D56" letter-spacing="0.08em">
        PATH A: LEGITIMATE AUTHENTICATION &amp; ISSUANCE
      </text>

      <!-- Browser A Chrome -->
      <g transform="translate(35, 60)">
        <rect width="180" height="120" fill="#F4F1E9" stroke="#151515" stroke-width="1.5"/>
        <!-- Window Titlebar -->
        <rect width="180" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1.5"/>
        <circle cx="14" cy="12" r="3.5" fill="#151515" fill-opacity="0.3"/>
        <circle cx="26" cy="12" r="3.5" fill="#151515" fill-opacity="0.3"/>
        <circle cx="38" cy="12" r="3.5" fill="#151515" fill-opacity="0.3"/>
        <rect x="52" y="5" width="118" height="14" fill="#F4F1E9" stroke="#151515" stroke-width="0.8" stroke-opacity="0.4"/>
        <text x="58" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">app.example.com/login</text>
        
        <!-- Browser Content -->
        <text x="16" y="50" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="600" fill="#151515">CLIENT / BROWSER A</text>
        <text x="16" y="66" font-family="sans-serif" font-size="9" fill="#5F5D56">User: Mouhib</text>
        <text x="16" y="80" font-family="sans-serif" font-size="9" fill="#5F5D56">Creds: user + pass</text>
        <!-- Hatch accent -->
        <rect x="16" y="92" width="148" height="16" fill="url(#hero-hatch)" stroke="#151515" stroke-width="0.8" stroke-opacity="0.3"/>
        <text x="32" y="104" font-family="'JetBrains Mono', monospace" font-size="8" fill="#151515">POST /api/auth/login</text>
      </g>

      <!-- Flow 1 Arrow: Browser A -> Server Rack -->
      <path d="M 215 120 L 350 120" stroke="#151515" stroke-width="1.5" marker-end="url(#arrow)"/>
      <rect x="235" y="102" width="95" height="16" fill="#F4F1E9" stroke="#151515" stroke-width="0.8" stroke-opacity="0.4"/>
      <text x="242" y="113" font-family="'JetBrains Mono', monospace" font-size="8" fill="#151515">1. Credentials</text>

      <!-- Server Rack (Detailed Centerpiece) -->
      <g transform="translate(365, 55)">
        <rect width="140" height="290" fill="#F4F1E9" stroke="#151515" stroke-width="1.8"/>
        <!-- Rack Ears & Screws -->
        <rect x="-4" y="10" width="4" height="270" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <rect x="140" y="10" width="4" height="270" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <circle cx="-2" cy="20" r="1.5" fill="#151515"/>
        <circle cx="-2" cy="270" r="1.5" fill="#151515"/>
        <circle cx="142" cy="20" r="1.5" fill="#151515"/>
        <circle cx="142" cy="270" r="1.5" fill="#151515"/>

        <!-- Server Blade 1 (Auth Engine) -->
        <rect x="8" y="15" width="124" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="1"/>
        <line x1="8" y1="28" x2="132" y2="28" stroke="#151515" stroke-width="0.5" stroke-dasharray="2 2"/>
        <circle cx="18" cy="21" r="2.5" fill="#5F6849"/>
        <circle cx="26" cy="21" r="2.5" fill="#151515" fill-opacity="0.3"/>
        <text x="36" y="24" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">AUTH VERIFICATION</text>
        <text x="18" y="47" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">Status: Valid Password</text>

        <!-- Server Blade 2 (Session State Store) -->
        <rect x="8" y="70" width="124" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="1"/>
        <rect x="14" y="78" width="112" height="36" fill="url(#hero-hatch)" stroke="#151515" stroke-width="0.8" stroke-opacity="0.3"/>
        <text x="24" y="92" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#151515">SESSION STORE (REDIS)</text>
        <text x="24" y="105" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">ID: a3f9e7c4... → UID:108</text>

        <!-- Central Divider on Rack -->
        <line x1="8" y1="145" x2="132" y2="145" stroke="#151515" stroke-width="1" stroke-dasharray="4 3"/>
        <text x="20" y="162" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#5F5D56">STATE LOOKUP ENGINE</text>

        <!-- Server Blade 3 (Session Validator) -->
        <rect x="8" y="185" width="124" height="55" fill="#FAF8F2" stroke="#151515" stroke-width="1"/>
        <circle cx="18" cy="198" r="3" fill="#5F6849"/>
        <text x="28" y="201" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#151515">COOKIE PARSER</text>
        <text x="18" y="217" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">Does token exist in RAM?</text>
        <text x="18" y="230" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#5F6849">YES → TRUST GRANTED</text>

        <!-- Rack Grille Ventilation -->
        <line x1="12" y1="255" x2="128" y2="255" stroke="#151515" stroke-width="0.8" stroke-opacity="0.3"/>
        <line x1="12" y1="262" x2="128" y2="262" stroke="#151515" stroke-width="0.8" stroke-opacity="0.3"/>
        <line x1="12" y1="269" x2="128" y2="269" stroke="#151515" stroke-width="0.8" stroke-opacity="0.3"/>
      </g>

      <!-- Flow 2 Arrow: Server -> Issues Session Cookie back to Browser A -->
      <path d="M 365 140 L 215 140" stroke="#5F6849" stroke-width="1.5" marker-end="url(#arrow-olive)"/>
      <rect x="230" y="145" width="112" height="18" fill="#F4F1E9" stroke="#5F6849" stroke-width="1"/>
      <text x="236" y="157" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#5F6849">2. Set-Cookie: id=ABC</text>

      <!-- SESSION TOKEN BADGE (MUTED OLIVE ISOLATED ASSET) -->
      <g transform="translate(565, 80)">
        <rect width="235" height="70" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.8"/>
        <rect x="4" y="4" width="227" height="62" fill="url(#olive-hatch)"/>
        <rect x="10" y="10" width="215" height="50" fill="#F4F1E9" stroke="#5F6849" stroke-width="1"/>
        <text x="20" y="28" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849" letter-spacing="0.08em">SESSION IDENTIFIER (COOKIE)</text>
        <text x="20" y="45" font-family="'JetBrains Mono', monospace" font-size="10.5" font-weight="600" fill="#151515">session_id=a3f9e7c4b281</text>
      </g>

      <!-- Arrow: Server sends token to Token Display -->
      <path d="M 505 115 L 565 115" stroke="#5F6849" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#arrow-olive)"/>

      <!-- SECTION 2: ADVERSARY REUSE PATH (LOWER PATH) -->
      <!-- Dotted Separation Rule -->
      <line x1="35" y1="215" x2="330" y2="215" stroke="#151515" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.3"/>
      <text x="35" y="235" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600" fill="#8F2D2D" letter-spacing="0.08em">
        PATH B: ADVERSARIAL REUSE (ZERO PASSWORD INVOLVEMENT)
      </text>

      <!-- Browser B Chrome (Attacker / Rogue Device) -->
      <g transform="translate(35, 255)">
        <rect width="180" height="120" fill="#F4F1E9" stroke="#151515" stroke-width="1.5"/>
        <!-- Window Titlebar with dark tint -->
        <rect width="180" height="24" fill="#E2DDD2" stroke="#151515" stroke-width="1.5"/>
        <circle cx="14" cy="12" r="3.5" fill="#8F2D2D"/>
        <circle cx="26" cy="12" r="3.5" fill="#151515" fill-opacity="0.3"/>
        <circle cx="38" cy="12" r="3.5" fill="#151515" fill-opacity="0.3"/>
        <rect x="52" y="5" width="118" height="14" fill="#F4F1E9" stroke="#151515" stroke-width="0.8" stroke-opacity="0.4"/>
        <text x="58" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">app.example.com/account</text>

        <!-- Browser Content -->
        <text x="16" y="48" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="600" fill="#151515">CLIENT / BROWSER B</text>
        <text x="16" y="63" font-family="sans-serif" font-size="8.5" fill="#8F2D2D">Attacker / Untrusted Device</text>
        <text x="16" y="78" font-family="sans-serif" font-size="8.5" fill="#5F5D56">Password: UNKNOWN</text>

        <!-- Injected Cookie -->
        <rect x="12" y="86" width="156" height="24" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.2"/>
        <text x="18" y="102" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#5F6849">Cookie: session_id=a3f9e...</text>
      </g>

      <!-- Arrow from Stolen Token down into Browser B -->
      <path d="M 680 150 L 680 315 L 215 315" stroke="#5F6849" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#arrow-olive)"/>
      <rect x="585" y="235" width="140" height="20" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
      <text x="592" y="248" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#5F6849">Token Exfiltrated / Reused</text>

      <!-- Flow Arrow: Browser B -> Sends Token to Server Blade 3 -->
      <path d="M 215 280 L 365 280" stroke="#151515" stroke-width="1.5" marker-end="url(#arrow)"/>
      <rect x="230" y="268" width="120" height="16" fill="#F4F1E9" stroke="#151515" stroke-width="0.8" stroke-opacity="0.4"/>
      <text x="236" y="279" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">GET /account (Cookie: id=ABC)</text>

      <!-- Output / Result Box from Server to Browser B -->
      <g transform="translate(565, 260)">
        <rect width="235" height="85" fill="#FAF8F2" stroke="#151515" stroke-width="1.5"/>
        <rect x="4" y="4" width="227" height="18" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">SERVER RESPONSE: 200 OK</text>
        <text x="12" y="38" font-family="sans-serif" font-size="9" fill="#151515">Session recognized: <tspan fill="#5F6849" font-weight="bold">User Mouhib</tspan></text>
        <text x="12" y="54" font-family="sans-serif" font-size="8.5" fill="#5F5D56">No password requested.</text>
        <text x="12" y="70" font-family="sans-serif" font-size="8.5" fill="#8F2D2D">Full account access granted.</text>
      </g>

      <path d="M 505 280 L 565 280" stroke="#151515" stroke-width="1.5" marker-end="url(#arrow)"/>

      <!-- BOTTOM BANNER: THE CORE ARCHITECTURAL PRINCIPLE -->
      <g transform="translate(35, 388)">
        <rect width="770" height="32" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <rect x="4" y="4" width="6" height="24" fill="#5F6849"/>
        <text x="20" y="21" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#151515" letter-spacing="0.06em">
          MAIN PRINCIPLE: The server trusts the session token — it cannot tell who is actually behind the screen.
        </text>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 00: مسار إنشاء الجلسة الشرعي (أعلى) مقابل مسار إعادة استخدام المعرّف من متصفح غير مصرح به (أسفل) دون الحاجة لكلمة السر.'
      : 'Figure 00: Legitimate authentication flow (top) vs. adversarial session token replay from a foreign device (bottom) without re-authenticating.'}
  </figcaption>
</figure>
