---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'تبادل أوامر APDU لبروتوكول EMV بين القارئ والشريحة' : 'Typical EMV contactless APDU command and response exchange'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 03 / حوار الأوامر' : 'FIGURE 03 / APDU PROTOCOL EXCHANGE'}
    </span>
    <span>
      {lang === 'ar' ? 'المحادثة اللاتلامسية النموذجية لبروتوكول EMV' : 'Typical conceptual EMV contactless command exchange'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 290" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="apdu-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="apdu-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="apdu-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="274" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Header note -->
      <text x="25" y="28" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">TYPICAL CONCEPTUAL EMV CONTACTLESS EXCHANGE (KERNEL SPECIFICATIONS MAY VARY)</text>

      <!-- Columns: POS Terminal vs Smart Card -->
      <line x1="220" y1="36" x2="220" y2="265" stroke="#151515" stroke-width="1" stroke-dasharray="2 2" stroke-opacity="0.3"/>
      <line x1="600" y1="36" x2="600" y2="265" stroke="#5F6849" stroke-width="1" stroke-dasharray="2 2" stroke-opacity="0.3"/>

      <text x="140" y="48" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">TERMINAL (READER)</text>
      <text x="590" y="48" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">CHIP (CARD / WALLET)</text>

      <!-- Exchange 1: SELECT PPSE / AID -->
      <g transform="translate(100, 60)">
        <line x1="120" y1="12" x2="490" y2="12" stroke="#151515" stroke-width="1.5" marker-end="url(#apdu-arr)"/>
        <rect x="180" y="0" width="250" height="24" fill="#F4F1E9" stroke="#151515" stroke-width="0.8"/>
        <text x="190" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">1. SELECT '2PAY.SYS.DDF01' (PPSE / AID)</text>

        <line x1="490" y1="36" x2="120" y2="36" stroke="#5F6849" stroke-width="1.5" marker-end="url(#apdu-arr-olive)"/>
        <rect x="200" y="24" width="210" height="22" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="210" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">Returns Application List &amp; PDOL (FCI)</text>
      </g>

      <!-- Exchange 2: GET PROCESSING OPTIONS (GPO) -->
      <g transform="translate(100, 115)">
        <line x1="120" y1="12" x2="490" y2="12" stroke="#151515" stroke-width="1.5" marker-end="url(#apdu-arr)"/>
        <rect x="180" y="0" width="250" height="24" fill="#F4F1E9" stroke="#151515" stroke-width="0.8"/>
        <text x="190" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">2. GET PROCESSING OPTIONS (GPO + PDOL)</text>

        <line x1="490" y1="36" x2="120" y2="36" stroke="#5F6849" stroke-width="1.5" marker-end="url(#apdu-arr-olive)"/>
        <rect x="210" y="24" width="190" height="22" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="220" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">Returns AIP &amp; AFL (File Locator)</text>
      </g>

      <!-- Exchange 3: READ RECORDS -->
      <g transform="translate(100, 170)">
        <line x1="120" y1="12" x2="490" y2="12" stroke="#151515" stroke-width="1.5" marker-end="url(#apdu-arr)"/>
        <rect x="195" y="0" width="220" height="24" fill="#F4F1E9" stroke="#151515" stroke-width="0.8"/>
        <text x="205" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">3. READ RECORD (Files indicated by AFL)</text>

        <line x1="490" y1="36" x2="120" y2="36" stroke="#5F6849" stroke-width="1.5" marker-end="url(#apdu-arr-olive)"/>
        <rect x="200" y="24" width="210" height="22" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="210" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">Returns PAN, Expiry, Issuer Public Key</text>
      </g>

      <!-- Exchange 4: GENERATE APPLICATION CRYPTOGRAM -->
      <g transform="translate(100, 225)">
        <line x1="120" y1="12" x2="490" y2="12" stroke="#151515" stroke-width="1.5" marker-end="url(#apdu-arr)"/>
        <rect x="180" y="0" width="250" height="24" fill="#F4F1E9" stroke="#5F6849" stroke-width="1"/>
        <text x="190" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">4. GENERATE AC (Amount, Currency, UN)</text>

        <line x1="490" y1="36" x2="120" y2="36" stroke="#5F6849" stroke-width="1.5" marker-end="url(#apdu-arr-olive)"/>
        <rect x="190" y="24" width="230" height="22" fill="#EBE7DE" stroke="#5F6849" stroke-width="1"/>
        <text x="200" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">Returns ARQC Cryptogram + ATC + CID</text>
      </g>
    </svg>
  </div>
</figure>
