---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'خطوات اتخاذ القرار والتفويض داخل خوادم البنك المصدر' : 'Issuer authorization decision pipeline and cryptographic validation'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 07 / قرار البنك' : 'FIGURE 07 / ISSUER DECISION PIPELINE'}
    </span>
    <span>
      {lang === 'ar' ? 'فحص التشفير، الرصيد، واحتيال العمليات داخل البنك المصدر (Issuer)' : 'ARQC validation, fund check, fraud scoring, and approval code generation'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="iss-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="iss-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="iss-arr-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Check 1: Cryptographic Validation (HSM) -->
      <g transform="translate(25, 35)">
        <rect width="180" height="210" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.5"/>
        <rect width="180" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">1. HARDWARE SECURITY (HSM)</text>

        <rect x="10" y="38" width="160" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">ARQC VERIFICATION</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Reconstructs session key</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Verifies card MAC matches</text>

        <rect x="10" y="98" width="160" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="112" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">ATC MONOTONICITY</text>
        <text x="14" y="126" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Checks ATC &gt; previous ATC</text>
        <text x="14" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Replay / cloned tap blocked</text>

        <rect x="10" y="156" width="160" height="40" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.6"/>
        <text x="14" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">RESULT: CARD AUTHENTIC</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <line x1="205" y1="140" x2="230" y2="140" stroke="#5F6849" stroke-width="1.6" marker-end="url(#iss-arr-olive)"/>

      <!-- Check 2: Account Status & Balance -->
      <g transform="translate(235, 35)">
        <rect width="180" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="180" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">2. ACCOUNT STATUS & FUNDS</text>

        <rect x="10" y="38" width="160" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">CARD STATUS</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Active (Not stolen / frozen)</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Expiration date valid</text>

        <rect x="10" y="98" width="160" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="112" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">BALANCE / CREDIT LINE</text>
        <text x="14" y="126" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Balance &gt;= $24.50</text>
        <text x="14" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Locks funds / sets auth hold</text>

        <rect x="10" y="156" width="160" height="40" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">RESULT: FUNDS RESERVED</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <line x1="415" y1="140" x2="440" y2="140" stroke="#151515" stroke-width="1.6" marker-end="url(#iss-arr)"/>

      <!-- Check 3: Fraud Risk Engine -->
      <g transform="translate(445, 35)">
        <rect width="180" height="210" fill="#F4F1E9" stroke="#151515" stroke-width="1.3"/>
        <rect width="180" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">3. REAL-TIME FRAUD HEURISTICS</text>

        <rect x="10" y="38" width="160" height="52" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">VELOCITY & PATTERNS</text>
        <text x="14" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Number of taps today</text>
        <text x="14" y="78" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Geolocation feasibility check</text>

        <rect x="10" y="98" width="160" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
        <text x="14" y="112" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">CONTACTLESS LIMITS</text>
        <text x="14" y="126" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Below cumulative limit</text>
        <text x="14" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• No PIN step-up demanded</text>

        <rect x="10" y="156" width="160" height="40" fill="url(#iss-hatch)" stroke="#151515" stroke-width="0.6"/>
        <text x="14" y="172" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">RISK SCORE: LOW (&lt; 15)</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <line x1="625" y1="140" x2="650" y2="140" stroke="#5F6849" stroke-width="1.8" marker-end="url(#iss-arr-olive)"/>

      <!-- Step 4: Authorization Decision -->
      <g transform="translate(655, 35)">
        <rect width="140" height="210" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.5"/>
        <rect width="140" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="10" y="17" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">4. AUTHORIZATION</text>

        <rect x="8" y="38" width="124" height="66" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">RESPONSE: 00</text>
        <text x="12" y="66" font-family="sans-serif" font-size="7.5" fill="#151515">Approved</text>
        <text x="12" y="80" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">AUTH: 739201</text>
        <text x="12" y="94" font-family="sans-serif" font-size="6.5" fill="#5F5D56">Unique 6-char auth code</text>

        <rect x="8" y="112" width="124" height="88" fill="#EBE7DE" stroke="#151515" stroke-width="0.6"/>
        <text x="12" y="128" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#151515">OPTIONAL ARPC</text>
        <text x="12" y="142" font-family="sans-serif" font-size="7" fill="#5F5D56">Issuer Authentication</text>
        <text x="12" y="156" font-family="sans-serif" font-size="7" fill="#5F5D56">Cryptogram sent to</text>
        <text x="12" y="168" font-family="sans-serif" font-size="7" fill="#5F5D56">chip if requested</text>
        <text x="12" y="184" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#5F6849">DISPATCH RETURN</text>
      </g>
    </svg>
  </div>
</figure>
