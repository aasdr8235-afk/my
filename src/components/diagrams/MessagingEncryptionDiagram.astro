---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مقارنة بين التشفير أثناء النقل والتشفير بين الطرفين' : 'Comparison between In-Transit TLS encryption and End-to-End Encryption (E2EE)'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 03 / نماذج التشفير' : 'FIGURE 03 / ENCRYPTION ARCHITECTURES'}
    </span>
    <span>
      {lang === 'ar' ? 'التشفير أثناء النقل (TLS) مقابل التشفير بين الطرفين (E2EE)' : 'In-Transit Encryption vs End-to-End Encryption'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 300" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="enc-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <marker id="enc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515"/>
        </marker>
        <marker id="enc-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849"/>
        </marker>
      </defs>

      <!-- Outer Frame -->
      <rect x="8" y="8" width="804" height="284" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- SECTION A: IN-TRANSIT ONLY (HOP-BY-HOP) -->
      <g transform="translate(25, 25)">
        <rect width="770" height="115" fill="#F4F1E9" stroke="#151515" stroke-width="1.2"/>
        <rect width="770" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="0.8"/>
        <text x="12" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">MODEL A: IN-TRANSIT ENCRYPTION ONLY (TLS HOP-BY-HOP)</text>

        <!-- Sender -->
        <rect x="15" y="32" width="150" height="70" fill="#FAF8F2" stroke="#151515" stroke-width="0.8"/>
        <text x="25" y="50" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">Sender Client</text>
        <text x="25" y="68" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Plaintext in app</text>
        <text x="25" y="84" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">TLS uplink encryption</text>

        <!-- Pipe 1 -->
        <line x1="165" y1="67" x2="275" y2="67" stroke="#151515" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#enc-arrow)"/>
        <text x="180" y="60" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">TLS Tunnel 1</text>

        <!-- Server (Plaintext visible) -->
        <rect x="280" y="32" width="210" height="70" fill="#FAF8F2" stroke="#D32F2F" stroke-width="1.2"/>
        <text x="290" y="50" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#D32F2F">Service Core / Database</text>
        <text x="290" y="68" font-family="sans-serif" font-size="7.5" fill="#D32F2F">• TLS terminates here</text>
        <text x="290" y="84" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Content readable / indexable</text>

        <!-- Pipe 2 -->
        <line x1="490" y1="67" x2="600" y2="67" stroke="#151515" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#enc-arrow)"/>
        <text x="505" y="60" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">TLS Tunnel 2</text>

        <!-- Recipient -->
        <rect x="605" y="32" width="150" height="70" fill="#FAF8F2" stroke="#151515" stroke-width="0.8"/>
        <text x="615" y="50" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">Recipient Client</text>
        <text x="615" y="68" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Plaintext received</text>
        <text x="615" y="84" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">TLS downlink</text>
      </g>

      <!-- SECTION B: END-TO-END ENCRYPTION (E2EE) -->
      <g transform="translate(25, 155)">
        <rect width="770" height="125" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.4"/>
        <rect width="770" height="22" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
        <text x="12" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">MODEL B: END-TO-END ENCRYPTED (E2EE PAYLOAD WITH DUAL-LAYER SECURITY)</text>

        <!-- Sender -->
        <rect x="15" y="32" width="150" height="80" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="25" y="50" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">Sender Client</text>
        <text x="25" y="68" font-family="sans-serif" font-size="7.5" fill="#5F6849">1. Encrypts payload (E2EE)</text>
        <text x="25" y="82" font-family="sans-serif" font-size="7.5" fill="#5F5D56">2. Wraps in TLS packet</text>
        <text x="25" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">Holds Sender PrivKey</text>

        <!-- Pipe 1 -->
        <line x1="165" y1="72" x2="275" y2="72" stroke="#5F6849" stroke-width="1.8" marker-end="url(#enc-arrow-olive)"/>
        <text x="175" y="64" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">TLS + Ciphertext</text>

        <!-- Server (Opaque) -->
        <rect x="280" y="32" width="210" height="80" fill="#FAF8F2" stroke="#151515" stroke-width="1"/>
        <text x="290" y="50" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">Relay Server / Queue</text>
        <text x="290" y="68" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Sees routing envelope</text>
        <text x="290" y="82" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Payload is random bytes</text>
        <text x="290" y="96" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#5F6849">NO DECRYPTION KEYS</text>

        <!-- Pipe 2 -->
        <line x1="490" y1="72" x2="600" y2="72" stroke="#5F6849" stroke-width="1.8" marker-end="url(#enc-arrow-olive)"/>
        <text x="500" y="64" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">TLS + Ciphertext</text>

        <!-- Recipient -->
        <rect x="605" y="32" width="150" height="80" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="615" y="50" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">Recipient Client</text>
        <text x="615" y="68" font-family="sans-serif" font-size="7.5" fill="#5F5D56">1. Unwraps TLS packet</text>
        <text x="615" y="82" font-family="sans-serif" font-size="7.5" fill="#5F6849">2. Decrypts with local key</text>
        <text x="615" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">Holds Recipient PrivKey</text>
      </g>
    </svg>
  </div>
</figure>
