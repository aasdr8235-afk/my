---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مقارنة بين البطاقة البلاستيكية ومحافظ الهواتف الذكية' : 'Comparison between physical contactless cards and tokenized smartphone wallets'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 09 / المحافظ والترميز' : 'FIGURE 09 / CARDS VS PHONE WALLETS'}
    </span>
    <span>
      {lang === 'ar' ? 'البطاقة البلاستيكية مقابل الهاتف (Apple Pay / Google Wallet)' : 'Physical card (FPAN) vs Tokenized wallet (DPAN & CDCVM)'}
    </span>
  </div>

  <div class="diagram-svg-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <svg viewBox="0 0 820 290" width="100%" height="auto" style="min-width: 680px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="wlt-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12"/>
        </pattern>
        <pattern id="wlt-olive-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5F6849" stroke-width="0.75" stroke-opacity="0.2"/>
        </pattern>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="274" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25"/>

      <!-- Left Column: Physical Plastic Card -->
      <g transform="translate(25, 25)">
        <rect width="370" height="240" fill="#F4F1E9" stroke="#151515" stroke-width="1.4"/>
        <rect width="370" height="26" fill="#EBE7DE" stroke="#151515" stroke-width="1"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">MODEL A: PHYSICAL CONTACTLESS CARD</text>

        <!-- Card Visual Representation -->
        <g transform="translate(15, 38)">
          <rect width="340" height="65" rx="5" fill="#FAF8F2" stroke="#151515" stroke-width="1"/>
          <text x="16" y="24" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">FUNDING PAN (FPAN)</text>
          <text x="16" y="40" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#5F6849">4111 2233 4455 8492</text>
          <text x="16" y="54" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Same 16-digit number printed on plastic</text>
        </g>

        <!-- Security properties -->
        <g transform="translate(15, 112)">
          <rect width="340" height="74" fill="#FAF8F2" stroke="#151515" stroke-width="0.7"/>
          <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">AUTHENTICATION & LIMITS</text>
          <text x="12" y="32" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• No biometric confirmation on the plastic itself</text>
          <text x="12" y="46" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Anyone holding the physical card can tap for small amounts</text>
          <text x="12" y="60" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Exceeding threshold triggers PIN prompt on terminal</text>
        </g>

        <rect x="15" y="194" width="340" height="30" fill="url(#wlt-hatch)" stroke="#151515" stroke-width="0.6"/>
        <text x="20" y="213" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">Card chip computes ARQC using stored card keys</text>
      </g>

      <!-- Right Column: Smartphone Digital Wallet -->
      <g transform="translate(415, 25)">
        <rect width="380" height="240" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6"/>
        <rect width="380" height="26" fill="#FAF8F2" stroke="#5F6849" stroke-width="1"/>
        <text x="12" y="17" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">MODEL B: SMARTPHONE WALLET (APPLE / GOOGLE)</text>

        <!-- Wallet Visual Representation -->
        <g transform="translate(15, 38)">
          <rect width="350" height="65" rx="5" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.2"/>
          <text x="16" y="24" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">TOKENIZED DPAN (DEVICE PAN)</text>
          <text x="16" y="40" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#151515">•••• •••• •••• 9104 (SURROGATE TOKEN)</text>
          <text x="16" y="54" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Real FPAN is never stored on device and never sent via NFC</text>
        </g>

        <!-- Security properties -->
        <g transform="translate(15, 112)">
          <rect width="350" height="74" fill="#FAF8F2" stroke="#5F6849" stroke-width="0.8"/>
          <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">CDCVM (ON-DEVICE BIOMETRIC AUTH)</text>
          <text x="12" y="32" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Fingerprint, Face ID, or device passcode validates identity</text>
          <text x="12" y="46" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Satisfies CVM locally: no terminal PIN needed even for large sums</text>
          <text x="12" y="60" font-family="sans-serif" font-size="7.5" fill="#5F5D56">• Secure Element (eSE) / Host Card Emulation (HCE) isolation</text>
        </g>

        <rect x="15" y="194" width="350" height="30" fill="url(#wlt-olive-hatch)" stroke="#5F6849" stroke-width="0.7"/>
        <text x="20" y="213" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#5F6849">Token de-tokenized at Card Scheme / Token Service Provider</text>
      </g>
    </svg>
  </div>
</figure>
