---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط طبقة ربط البيانات واستكشاف موجه البوابة المحلية عبر ARP وNDP' : 'Data Link layer next-hop gateway resolution via ARP and NDP'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 02 / الشبكة المحلية (LAN)' : 'DIAGRAM 02 / LOCAL SUBNET'}
    </span>
    <span>
      {lang === 'ar' ? 'استكشاف عنوان MAC للموجّه الافتراضي (ARP / NDP)' : 'Next-Hop Gateway MAC Resolution (ARP / NDP)'}
    </span>
  </div>

  <div class="diagram-svg-container">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 640px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="arp-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12" />
        </pattern>
        <marker id="arp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515" />
        </marker>
        <marker id="arp-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849" />
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25" />
      <line x1="8" y1="24" x2="8" y2="8" stroke="#151515" stroke-width="2" />
      <line x1="8" y1="8" x2="24" y2="8" stroke="#151515" stroke-width="2" />
      <line x1="812" y1="256" x2="812" y2="272" stroke="#151515" stroke-width="2" />
      <line x1="812" y1="272" x2="796" y2="272" stroke="#151515" stroke-width="2" />

      <!-- LOCAL SUBNET BOUNDARY (LEFT BOX) -->
      <g transform="translate(25, 30)">
        <rect width="470" height="205" fill="#F4F1E9" stroke="#151515" stroke-width="1.4" stroke-dasharray="4 3" />
        <text x="14" y="20" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F5D56">LOCAL SUBNET: 192.168.1.0/24 (ETHERNET BROADCAST DOMAIN)</text>

        <!-- Node 1: Client Host -->
        <g transform="translate(15, 35)">
          <rect width="180" height="150" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" />
          <rect width="180" height="22" fill="#EBE7DE" stroke="#151515" stroke-width="0.8" />
          <text x="10" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">CLIENT WORKSTATION</text>
          <text x="10" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">IP: 192.168.1.50</text>
          <text x="10" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">MAC: e4:5f:01:2b:88:12</text>
          <line x1="10" y1="60" x2="170" y2="60" stroke="#151515" stroke-width="0.5" stroke-opacity="0.2" />
          
          <rect x="8" y="68" width="164" height="42" fill="#F4F1E9" stroke="#5F6849" stroke-width="1" />
          <text x="14" y="82" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">SUBNET EVALUATION:</text>
          <text x="14" y="94" font-family="sans-serif" font-size="7.5" fill="#151515">Target 93.184.216.34</text>
          <text x="14" y="104" font-family="sans-serif" font-size="7.5" font-weight="600" fill="#8F2D2D">OUTSIDE local subnet!</text>

          <text x="10" y="126" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">Resolution: Send to Gateway</text>
          <text x="10" y="138" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="600" fill="#5F6849">Query: Who has 192.168.1.1?</text>
        </g>

        <!-- LAN Query Exchange Arrow -->
        <path d="M 205 95 L 265 95" stroke="#151515" stroke-width="1.4" marker-end="url(#arp-arrow)" />
        <rect x="208" y="82" width="50" height="13" fill="#FAF8F2" stroke="#151515" stroke-width="0.5" />
        <text x="212" y="91" font-family="'JetBrains Mono', monospace" font-size="6.8" fill="#151515">ARP / NDP</text>

        <path d="M 265 125 L 205 125" stroke="#5F6849" stroke-width="1.4" stroke-dasharray="3 3" marker-end="url(#arp-arrow-olive)" />
        <text x="210" y="140" font-family="'JetBrains Mono', monospace" font-size="6.8" font-weight="600" fill="#5F6849">Gateway MAC</text>

        <!-- Node 2: Local Gateway Router -->
        <g transform="translate(275, 35)">
          <rect width="180" height="150" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.5" />
          <rect width="180" height="22" fill="#EBE7DE" stroke="#5F6849" stroke-width="0.8" />
          <text x="10" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">DEFAULT GATEWAY (ROUTER)</text>
          <text x="10" y="38" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">LAN IP: 192.168.1.1</text>
          <text x="10" y="52" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">MAC: 00:1a:2b:3c:4d:5e</text>
          <line x1="10" y1="60" x2="170" y2="60" stroke="#151515" stroke-width="0.5" stroke-opacity="0.2" />

          <rect x="8" y="68" width="164" height="42" fill="url(#arp-hatch)" stroke="#151515" stroke-width="0.8" />
          <text x="14" y="84" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="600" fill="#151515">L2 ETHERNET FRAME:</text>
          <text x="14" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">Dest MAC: 00:1a:2b:3c:4d:5e</text>
          <text x="14" y="105" font-family="'JetBrains Mono', monospace" font-size="7" fill="#151515">Dest IP: 93.184.216.34</text>

          <text x="10" y="126" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">WAN IP: 198.51.100.12</text>
          <text x="10" y="138" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Removes L2, routes L3 packet</text>
        </g>
      </g>

      <!-- Arrow Subnet to WAN -->
      <path d="M 505 110 L 545 110" stroke="#151515" stroke-width="1.8" marker-end="url(#arp-arrow)" />

      <!-- REMOTE INTERNET / DESTINATION (RIGHT BOX) -->
      <g transform="translate(555, 30)">
        <rect width="240" height="205" fill="#F4F1E9" stroke="#151515" stroke-width="1.4" />
        <rect width="240" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1" />
        <text x="14" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">REMOTE DESTINATION (WAN)</text>

        <rect x="12" y="38" width="216" height="55" fill="#FAF8F2" stroke="#151515" stroke-width="1" />
        <text x="18" y="54" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">REMOTE WEB SERVER</text>
        <text x="18" y="68" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">IP: 93.184.216.34</text>
        <text x="18" y="82" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F5D56">MAC: fe:02:99:aa:bb:cc</text>

        <!-- CORE AXIOM BANNER -->
        <rect x="12" y="105" width="216" height="75" fill="#FAF8F2" stroke="#8F2D2D" stroke-width="1.2" />
        <rect x="12" y="105" width="4" height="75" fill="#8F2D2D" />
        <text x="22" y="122" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#8F2D2D">CRITICAL NETWORKING FACT:</text>
        <text x="22" y="138" font-family="sans-serif" font-size="7.5" fill="#151515">Your computer NEVER resolves</text>
        <text x="22" y="152" font-family="sans-serif" font-size="7.5" fill="#151515">the remote web server's MAC.</text>
        <text x="22" y="168" font-family="sans-serif" font-size="7.5" font-weight="600" fill="#5F6849">MAC address changes at every hop.</text>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 02: استكشاف طبقة الربط (L2) — عندما تكون الوجهة خارج الشبكة المحلية، يرسل جهازك حزمة ARP/NDP لمعرفة عنوان MAC الخاص بالراوتر المحلي فقط، وليس خادم الويب البعيد.'
      : 'Figure 02: Link layer next-hop resolution — when the destination is outside the local subnet, the host resolves the default gateway MAC address (via ARP/NDP), never the remote server MAC.'}
  </figcaption>
</figure>
