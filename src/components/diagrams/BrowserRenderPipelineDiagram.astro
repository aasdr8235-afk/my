---
interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
---

<figure class="diagram-figure" aria-label={lang === 'ar' ? 'مخطط مراحل معالجة المتصفح للشاشات: DOM وCSSOM والتخطيط والرسم' : 'Browser critical rendering pipeline: DOM, CSSOM, layout, paint, and composite'}>
  <div class="diagram-header">
    <span class="diagram-tag">
      {lang === 'ar' ? 'مخطط 07 / محرك العرض' : 'DIAGRAM 07 / RENDERING ENGINE'}
    </span>
    <span>
      {lang === 'ar' ? 'من بايتات الـHTML إلى البكسلات: العمليات المتداخلة والمتزامنة' : 'From Network Bytes to Pixels: Overlapping Pipeline Stages'}
    </span>
  </div>

  <div class="diagram-svg-container">
    <svg viewBox="0 0 820 280" width="100%" height="auto" style="min-width: 640px; display: block;" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="render-hatch" width="6" height="6" patternTransform="rotate(45 0 0)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#151515" stroke-width="0.75" stroke-opacity="0.12" />
        </pattern>
        <marker id="render-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#151515" />
        </marker>
        <marker id="render-arrow-olive" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 9 5 L 0 9 z" fill="#5F6849" />
        </marker>
      </defs>

      <!-- Frame -->
      <rect x="8" y="8" width="804" height="264" fill="#FAF8F2" stroke="#151515" stroke-width="1.2" stroke-opacity="0.25" />
      <line x1="8" y1="24" x2="8" y2="8" stroke="#151515" stroke-width="2" />
      <line x1="8" y1="8" x2="24" y2="8" stroke="#151515" stroke-width="2" />
      <line x1="812" y1="256" x2="812" y2="272" stroke="#151515" stroke-width="2" />
      <line x1="812" y1="272" x2="796" y2="272" stroke="#151515" stroke-width="2" />

      <!-- STAGE 1: PARALLEL PARSING (LEFT) -->
      <g transform="translate(25, 30)">
        <rect width="240" height="205" fill="#F4F1E9" stroke="#151515" stroke-width="1.4" />
        <rect width="240" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1" />
        <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">01 / OVERLAPPING PARSING</text>

        <!-- Stream A: HTML -> DOM -->
        <rect x="10" y="36" width="220" height="60" fill="#FAF8F2" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="52" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">HTML STREAM → DOM TREE</text>
        <text x="18" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Incremental tokenization</text>
        <text x="18" y="80" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#5F6849">Document Object Model</text>

        <!-- Stream B: CSS -> CSSOM -->
        <rect x="10" y="105" width="220" height="58" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.2" />
        <text x="18" y="121" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">CSS PARSER → CSSOM</text>
        <text x="18" y="135" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Render-blocking stylesheets</text>
        <text x="18" y="148" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#151515">Cascade &amp; inheritance</text>

        <text x="12" y="185" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">Preload scanner fetches async</text>
      </g>

      <!-- Arrows from Stage 1 into Stage 2 -->
      <path d="M 265 80 L 315 110" stroke="#151515" stroke-width="1.4" marker-end="url(#render-arrow)" />
      <path d="M 265 145 L 315 125" stroke="#5F6849" stroke-width="1.4" marker-end="url(#render-arrow-olive)" />

      <!-- STAGE 2: RENDER TREE & SCRIPT EXECUTION (CENTER) -->
      <g transform="translate(320, 30)">
        <rect width="210" height="205" fill="#F4F1E9" stroke="#5F6849" stroke-width="1.6" />
        <rect width="210" height="24" fill="#EBE7DE" stroke="#5F6849" stroke-width="1" />
        <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#5F6849">02 / RENDER TREE &amp; JS</text>

        <rect x="10" y="38" width="190" height="70" fill="url(#render-hatch)" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="56" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#151515">RENDER TREE</text>
        <text x="18" y="70" font-family="sans-serif" font-size="7.5" fill="#151515">Combines visible DOM nodes</text>
        <text x="18" y="84" font-family="sans-serif" font-size="7.5" fill="#5F5D56">with computed CSS styles</text>
        <text x="18" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#8F2D2D">(display: none excluded)</text>

        <!-- JavaScript Engine V8/SpiderMonkey -->
        <rect x="10" y="118" width="190" height="50" fill="#FAF8F2" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="134" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#151515">JAVASCRIPT (V8 / JIT)</text>
        <text x="18" y="148" font-family="sans-serif" font-size="7.5" fill="#5F5D56">May mutate DOM/CSSOM</text>
        <text x="18" y="160" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F6849">async / defer optimize flow</text>

        <text x="12" y="195" font-family="'JetBrains Mono', monospace" font-size="7" fill="#5F5D56">Calculates geometry</text>
      </g>

      <!-- Arrow Stage 2 -> Stage 3 -->
      <path d="M 530 115 L 565 115" stroke="#151515" stroke-width="1.6" marker-end="url(#render-arrow)" />

      <!-- STAGE 3: LAYOUT, PAINT & COMPOSITING (RIGHT) -->
      <g transform="translate(570, 30)">
        <rect width="225" height="205" fill="#F4F1E9" stroke="#151515" stroke-width="1.4" />
        <rect width="225" height="24" fill="#EBE7DE" stroke="#151515" stroke-width="1" />
        <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#151515">03 / DISPLAY PIPELINE</text>

        <!-- Box 1: Layout / Reflow -->
        <rect x="10" y="36" width="205" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="52" font-family="'JetBrains Mono', monospace" font-size="7.8" font-weight="700" fill="#151515">LAYOUT (REFLOW)</text>
        <text x="18" y="66" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Calculates exact x, y, width, height</text>

        <!-- Box 2: Paint -->
        <rect x="10" y="86" width="205" height="42" fill="#FAF8F2" stroke="#151515" stroke-width="0.8" />
        <text x="18" y="102" font-family="'JetBrains Mono', monospace" font-size="7.8" font-weight="700" fill="#151515">PAINT (RASTERIZATION)</text>
        <text x="18" y="116" font-family="sans-serif" font-size="7.5" fill="#5F5D56">Converts vectors/text into pixel tiles</text>

        <!-- Box 3: Composite (GPU) -->
        <rect x="10" y="136" width="205" height="52" fill="#FAF8F2" stroke="#5F6849" stroke-width="1.2" />
        <text x="18" y="152" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#5F6849">COMPOSITING (GPU)</text>
        <text x="18" y="166" font-family="sans-serif" font-size="7.5" fill="#151515">GPU layers assembled on screen</text>
        <text x="18" y="178" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#5F6849">FIRST CONTENTFUL PAINT (FCP)</text>
      </g>
    </svg>
  </div>

  <figcaption class="diagram-caption">
    {lang === 'ar'
      ? 'الشكل 07: مسار معالجة المتصفح — بناء شجرتي DOM وCSSOM بالتوازي، ودمجهما في شجرة العرض (Render Tree)، ثم حساب الأبعاد والمواقع (Layout)، وتفريغ البكسلات (Paint)، وتجميع الطبقات على المعالج الرسومي (Compositing).'
      : 'Figure 07: Browser rendering pipeline — parallel construction of the DOM and CSSOM, combined into the Render Tree, followed by geometric calculation (Layout), rasterization (Paint), and GPU layer assembly (Compositing).'}
  </figcaption>
</figure>
